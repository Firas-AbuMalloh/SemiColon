                                    <!-- Monthly Sales Chart (Stock Market Style) -->
                                    <div class="row">
                                        <div class="col-lg-6 mb-4">
                                            <div class="card shadow mb-4">
                                                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                                                    <h6 class="m-0 font-weight-bold text-primary">Monthly Sales Chart</h6>
                                                    <div class="dropdown no-arrow">
                                                        <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                            <i class="fas fa-ellipsis-v fa-sm fa-fw text-gray-400"></i>
                                                        </a>
                                                        <div class="dropdown-menu dropdown-menu-right shadow animated--fade-in" aria-labelledby="dropdownMenuLink">
                                                            <div class="dropdown-header">Time Range:</div>
                                                            <a class="dropdown-item chart-time-option" data-range="week" href="#"><i class="fas fa-calendar-week mr-2"></i>Last Week</a>
                                                            <a class="dropdown-item chart-time-option" data-range="month" href="#"><i class="fas fa-calendar-alt mr-2"></i>Last Month</a>
                                                            <a class="dropdown-item chart-time-option active" data-range="6months" href="#"><i class="fas fa-calendar mr-2"></i>Last 6 Months</a>
                                                            <div class="dropdown-divider"></div>
                                                            <a class="dropdown-item" href="#" id="refreshSalesData"><i class="fas fa-sync-alt mr-2"></i>Refresh Data</a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-body">
                                                    <div id="stockChartContainer" style="height: 300px;"></div>
                                                    
                                                    @* Create data for ApexCharts *@
                                                    <script>
                                                        document.addEventListener('DOMContentLoaded', function() {
                                                            // Data from server-side
                                                            const monthNames = @Html.Raw(Json.Serialize(monthNames));
                                                            const monthlyRevenue = @Html.Raw(Json.Serialize(monthlyRevenue));
                                                            
                                                            // Options for the candlestick chart (simulated from monthly data)
                                                            const options = {
                                                                series: [{
                                                                    name: 'Monthly Sales',
                                                                    data: monthlyRevenue.map((value, index) => {
                                                                        // Create stock-like data points
                                                                        const baseValue = value;
                                                                        const open = baseValue * (0.9 + Math.random() * 0.2);
                                                                        const high = baseValue * (1.05 + Math.random() * 0.1);
                                                                        const low = baseValue * (0.85 + Math.random() * 0.1);
                                                                        const close = baseValue;
                                                                        
                                                                        return {
                                                                            x: monthNames[index],
                                                                            y: [open, high, low, close]
                                                                        };
                                                                    })
                                                                }],
                                                                chart: {
                                                                    type: 'candlestick',
                                                                    height: 280,
                                                                    toolbar: {
                                                                        show: false
                                                                    },
                                                                    animations: {
                                                                        enabled: true,
                                                                        easing: 'easeinout',
                                                                        speed: 800
                                                                    },
                                                                    background: 'transparent'
                                                                },
                                                                title: {
                                                                    text: 'Monthly Revenue Performance',
                                                                    align: 'left',
                                                                    style: {
                                                                        fontSize: '14px',
                                                                        fontWeight: 'bold',
                                                                        color: '#4e73df'
                                                                    }
                                                                },
                                                                tooltip: {
                                                                    enabled: true,
                                                                    custom: function({seriesIndex, dataPointIndex, w}) {
                                                                        const o = w.globals.seriesCandleO[seriesIndex][dataPointIndex];
                                                                        const h = w.globals.seriesCandleH[seriesIndex][dataPointIndex];
                                                                        const l = w.globals.seriesCandleL[seriesIndex][dataPointIndex];
                                                                        const c = w.globals.seriesCandleC[seriesIndex][dataPointIndex];
                                                                        
                                                                        return `
                                                                            <div class="apexcharts-tooltip-candlestick">
                                                                                <div>Month: <b>${monthNames[dataPointIndex]}</b></div>
                                                                                <div>Open: <b>$${o.toFixed(2)}</b></div>
                                                                                <div>High: <b>$${h.toFixed(2)}</b></div>
                                                                                <div>Low: <b>$${l.toFixed(2)}</b></div>
                                                                                <div>Close: <b>$${c.toFixed(2)}</b></div>
                                                                                <div>Actual Revenue: <b>$${monthlyRevenue[dataPointIndex].toFixed(2)}</b></div>
                                                                            </div>
                                                                        `;
                                                                    }
                                                                },
                                                                xaxis: {
                                                                    categories: monthNames,
                                                                    labels: {
                                                                        rotate: 0,
                                                                        style: {
                                                                            colors: '#5a5c69',
                                                                            fontSize: '12px'
                                                                        }
                                                                    }
                                                                },
                                                                yaxis: {
                                                                    decimalsInFloat: 0,
                                                                    labels: {
                                                                        formatter: function(val) {
                                                                            return '$' + val.toLocaleString();
                                                                        },
                                                                        style: {
                                                                            colors: '#5a5c69'
                                                                        }
                                                                    }
                                                                },
                                                                plotOptions: {
                                                                    candlestick: {
                                                                        colors: {
                                                                            upward: '#1cc88a',
                                                                            downward: '#e74a3b'
                                                                        },
                                                                        wick: {
                                                                            useFillColor: true
                                                                        }
                                                                    }
                                                                }
                                                            };
                                                            
                                                            const chart = new ApexCharts(document.querySelector('#stockChartContainer'), options);
                                                            chart.render();
                                                            
                                                            // Refresh data when requested
                                                            document.getElementById('refreshSalesData').addEventListener('click', function(e) {
                                                                e.preventDefault();
                                                                chart.updateSeries([{
                                                                    data: monthlyRevenue.map((value, index) => {
                                                                        const baseValue = value;
                                                                        const open = baseValue * (0.9 + Math.random() * 0.2);
                                                                        const high = baseValue * (1.05 + Math.random() * 0.1);
                                                                        const low = baseValue * (0.85 + Math.random() * 0.1);
                                                                        const close = baseValue;
                                                                        
                                                                        return {
                                                                            x: monthNames[index],
                                                                            y: [open, high, low, close]
                                                                        };
                                                                    })
                                                                }]);
                                                            });
                                                        });
                                                    </script>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Dashboard Stats -->
                                        <div class="col-lg-6 mb-4">
                                            <div class="card shadow mb-4">
                                                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">

/* تنسيقات الرسوم المتحركة لتحسين تجربة المستخدم */
@@keyframes fadeOut {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-20px); }
}

@@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

@@keyframes pulseHighlight {
    0% { transform: scale(1); background-color: inherit; }
    50% { transform: scale(1.05); background-color: #ffecf5; }
    100% { transform: scale(1); background-color: inherit; }
}

@@keyframes buttonPulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.15); }
    100% { transform: scale(1); }
}

@@keyframes spinner {
    to { transform: rotate(360deg); }
}

/* تأثيرات العناصر المضافة */
.deleting-row {
    position: relative;
    overflow: hidden;
}

.deleting-row::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 107, 107, 0.1);
    backdrop-filter: blur(1px);
    z-index: 1;
}

.deleting-row::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30px;
    height: 30px;
    margin: -15px 0 0 -15px;
    border: 3px solid rgba(255, 107, 107, 0.3);
    border-radius: 50%;
    border-top-color: #ff6b6b;
    animation: spinner 0.8s linear infinite;
    z-index: 2;
}

/* أنماط الإحصائيات */
.stat-updated {
    animation: pulseHighlight 1s ease;
}

/* تحسينات حقل البحث */
.contact-search-wrapper {
    position: relative;
}

.contact-search-input {
    padding: 10px 40px;
    border: 2px solid #e9ecef;
    border-radius: 10px;
    width: 100%;
    transition: all 0.3s ease;
}

.contact-search-input:focus {
    outline: none;
    border-color: #ff497c;
    box-shadow: 0 0 0 3px rgba(255, 73, 124, 0.1);
}

.contact-search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #adb5bd;
}

.contact-search-input:focus + .contact-search-icon {
    color: #ff497c;
}

/* تأثير قريب عند عرض الملاحظات الفارغة */
.empty-state {
    padding: 50px;
    text-align: center;
    animation: fadeIn 0.5s ease;
}

.empty-state i {
    font-size: 3rem;

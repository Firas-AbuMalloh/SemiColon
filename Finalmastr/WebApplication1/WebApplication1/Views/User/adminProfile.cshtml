			}
		})
		.catch(error => {
			console.error('Error:', error);
			Swal.fire({
				icon: 'error',
				title: 'Error',
				text: 'An error occurred while saving the card.'
			});
		});

        return false;
    };

    // Search functionality
	pmSearchInput.addEventListener("input", function() {
        filterCards();
    });
    
    // Clear search button functionality
    document.querySelector(".search-clear-btn").addEventListener("click", function() {
        pmSearchInput.value = "";
        filterCards();
    });
    
    // Add event listeners for new filters
    const cardCategoryFilter = document.getElementById("cardCategoryFilter");
    const cardStockFilter = document.getElementById("cardStockFilter");
    
    if (cardCategoryFilter) {
        cardCategoryFilter.addEventListener("change", function() {
            filterCards();
        });
    }
    
    if (cardStockFilter) {
        cardStockFilter.addEventListener("change", function() {
            filterCards();
        });
    }
    
    // Combined filter function
    function filterCards() {
        const searchFilter = pmSearchInput.value.toLowerCase();
        const categoryFilter = cardCategoryFilter ? cardCategoryFilter.value.toLowerCase() : "";
        const stockFilter = cardStockFilter ? cardStockFilter.value.toLowerCase() : "";
        
        const cardItems = document.querySelectorAll(".card-grid-item");
        let visibleCount = 0;

        cardItems.forEach(card => {
            const cardText = card.textContent.toLowerCase();
            const cardName = card.querySelector(".product-title").textContent.toLowerCase();
            const cardCategory = card.getAttribute("data-category") ? card.getAttribute("data-category").toLowerCase() : "";
            const cardStock = card.getAttribute("data-stock") ? card.getAttribute("data-stock").toLowerCase() : "";
            
            const matchesSearch = searchFilter === "" || 
                                 cardText.includes(searchFilter) || 
                                 cardName.includes(searchFilter) ||
                                 cardCategory.includes(searchFilter);
            const matchesCategory = categoryFilter === "" || cardCategory === categoryFilter;
            const matchesStock = stockFilter === "" || cardStock === stockFilter;
            
            if (matchesSearch && matchesCategory && matchesStock) {
                card.style.display = "";
                visibleCount++;
            } else {
                card.style.display = "none";
            }
        });
        
        // Show empty state if no cards match
        const cardsContainer = document.querySelector(".cards-grid-container .row");
        const existingEmptyState = document.querySelector(".card-empty-state");
        
        if (visibleCount === 0) {
            if (!existingEmptyState) {
                const emptyState = document.createElement("div");
                emptyState.className = "card-empty-state col-12";
                emptyState.innerHTML = `
                    <div class="empty-state" style="text-align: center; padding: 40px 20px;">
                        <i class="fas fa-search" style="font-size: 3rem; color: #ccc; margin-bottom: 15px;"></i>
                        <p style="font-size: 1.2rem; color: #777; margin-bottom: 20px;">No cards found matching your filters</p>
                        <button class="card-btn card-btn-primary" id="resetFiltersBtn">
                            <i class="fas fa-times"></i> Reset Filters
                        </button>
                    </div>
                `;
                cardsContainer.appendChild(emptyState);
                
                // Add reset button functionality
                document.getElementById("resetFiltersBtn").addEventListener("click", function() {
                    pmSearchInput.value = "";
                    if (cardCategoryFilter) cardCategoryFilter.value = "";
                    if (cardStockFilter) cardStockFilter.value = "";
                    filterCards();
                });
            }
        } else if (existingEmptyState) {
            existingEmptyState.remove();
        }
    }
</script>
<script>
    // DOM Elements
    const userModal = document.getElementById("userModal");
    const userAddBtn = document.getElementById("userAddBtn");
    const userModalClose = document.querySelector(".user-modal-close");
    const userCancelBtn = document.getElementById("userCancelBtn");
    const userForm = document.getElementById("userForm");
    const userModalTitle = document.getElementById("userModalTitle");
    const userSearchInput = document.getElementById("userSearchInput");
    const userTable = document.getElementById("userTable");
    const roleFilter = document.getElementById("roleFilter");
    const statusFilter = document.getElementById("statusFilter");

	// إخفاء زر إضافة مستخدم جديد لأننا سنسمح فقط بتعديل الصلاحيات
	if (userAddBtn) {
		userAddBtn.style.display = 'none';
	}

    // Close modal
    function closeModal() {
        userModal.style.display = "none";
    }

    userModalClose.addEventListener("click", closeModal);
    userCancelBtn.addEventListener("click", closeModal);

    // Close modal when clicking outside
    window.addEventListener("click", (e) => {
        if (e.target === userModal) {
            closeModal();
        }
    });

    // Activate view buttons
    document.querySelectorAll(".contact-view-btn").forEach(btn => {
        btn.addEventListener("click", function() {
            // Get data from button attributes
            const id = this.getAttribute('data-id');
            const name = this.getAttribute('data-name');
            const email = this.getAttribute('data-email');
            const phone = this.getAttribute('data-phone');
            const subject = this.getAttribute('data-subject');
            const message = this.getAttribute('data-message');
            const date = this.getAttribute('data-date');
            const status = this.getAttribute('data-status');
            
            // Store ID in hidden field
            document.getElementById("viewFeedbackId").value = id;
            
            // Populate the modal fields
            document.getElementById("contactViewName").textContent = name;
            document.getElementById("contactViewEmail").textContent = email;
            document.getElementById("contactViewPhone").textContent = phone || 'Not provided';
            document.getElementById("contactViewSubject").textContent = subject;
            document.getElementById("contactViewDate").textContent = date;
            document.getElementById("contactViewMessage").textContent = message;
            
            // Set hidden feedback ID for use in publish/delete actions
            document.getElementById("viewFeedbackId").value = id;
            
            // Update status display
            const statusElement = document.getElementById("contactViewStatus");
            statusElement.textContent = status;
            statusElement.className = status.includes("Published") ? 
                "contact-badge contact-badge-published" : 
                "contact-badge contact-badge-unpublished";
            
            // Update button label based on current status
            const publishBtn = document.getElementById("contactPublishBtn");
            if (status.includes("Published")) {
                publishBtn.innerHTML = '<i class="fas fa-times-circle"></i> Unpublish';
            } else {
                publishBtn.innerHTML = '<i class="fas fa-check-circle"></i> Publish as Testimonial';
            }

            contactViewModal.style.display = "block";
        });
    });

    // Activate edit buttons
    document.querySelectorAll(".contact-edit-btn").forEach(btn => {
        btn.addEventListener("click", function() {
            // In a real app, this would open an edit modal
            alert("Edit functionality would be implemented here");
        });
    });

    // Activate delete buttons
    document.querySelectorAll(".contact-delete-btn").forEach(btn => {
        btn.addEventListener("click", function() {
            const feedbackId = this.getAttribute('data-id');
            const row = this.closest("tr");
            
            Swal.fire({
                title: 'Are you sure?',
                text: 'You are about to delete this feedback message. This action cannot be undone!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Send delete request to server
                    fetch(`/User/deleteFeedback?id=${feedbackId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Remove the row from the table
                            row.remove();
                            
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: data.message,
                                timer: 1500,
                                showConfirmButton: false
                            });
                            
                            // Check if there are no more rows and show empty state if needed
                            const tableBody = document.querySelector('#contactTable tbody');
                            if (tableBody.querySelectorAll('tr:not(.feedback-empty-state)').length === 0) {
                                tableBody.innerHTML = `
                                    <tr class="feedback-empty-state">
                                        <td colspan="9">
                                            <div class="empty-state">
                                                <i class="fas fa-comment-alt"></i>
                                                <p>No feedback messages found</p>
                                            </div>
                                        </td>
                                    </tr>
                                `;
                            }
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An error occurred while deleting the feedback.'
                        });
                    });
                }
            });
        });
    });

    // Filter functionality
    document.querySelector(".contact-btn-primary").addEventListener("click", function() {
        const statusFilter = contactStatusFilter.value;
        const dateFilter = contactDateFilter.value;
        const searchTerm = contactSearchInput.value.toLowerCase();
        const rows = contactTable.querySelectorAll("tbody tr");

        const today = new Date();
        today.setHours(0, 0, 0, 0);

        const weekStart = new Date(today);
        weekStart.setDate(today.getDate() - today.getDay());

        const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);

        rows.forEach(row => {
            const status = row.cells[7].textContent.toLowerCase();
            const dateStr = row.cells[6].textContent;
            const messageDate = new Date(dateStr);
            messageDate.setHours(0, 0, 0, 0);

            const name = row.cells[1].textContent.toLowerCase();
            const email = row.cells[2].textContent.toLowerCase();
            const subject = row.cells[4].textContent.toLowerCase();
            const message = row.cells[5].textContent.toLowerCase();

            // Apply status filter
            const statusMatch = statusFilter === "all" ||
                              (statusFilter === "published" && status.includes("published")) ||
                              (statusFilter === "unpublished" && status.includes("unpublished"));

            // Apply date filter
            let dateMatch = true;
            if (dateFilter === "today") {
                dateMatch = messageDate.getTime() === today.getTime();
            } else if (dateFilter === "week") {
                dateMatch = messageDate >= weekStart;
            } else if (dateFilter === "month") {
                dateMatch = messageDate >= monthStart;
            }

            // Apply search filter
            const searchMatch = searchTerm === "" ||
                              name.includes(searchTerm) ||
                              email.includes(searchTerm) ||
                              subject.includes(searchTerm) ||
                              message.includes(searchTerm);

            // Show/hide based on all filters
            row.style.display = (statusMatch && dateMatch && searchMatch) ? "" : "none";
        });
    });

    // Toggle publish status
    document.getElementById("contactPublishBtn").addEventListener("click", function() {
        // Get the feedback ID
        const feedbackId = document.getElementById("viewFeedbackId").value;
        
        if (!feedbackId) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Could not identify feedback item.',
                toast: true,
                position: 'top-end',
                timer: 3000,
                timerProgressBar: true,
                showConfirmButton: false
            });
            return;
        }
        
        // Send request to toggle status
        fetch(`/User/toggleFeedbackStatus?id=${feedbackId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const statusElement = document.getElementById("contactViewStatus");
                const modalTitle = data.isPublished ? "Testimonial Published" : "Status Updated";
                const modalText = data.message;
                
                // Close the modal first
                document.getElementById("contactCloseBtn").click();
                
                // Find and remove the feedback card if published
                if (data.isPublished) {
                    const feedbackCard = document.querySelector(`.feedback-card[data-id="${feedbackId}"]`);
                    if (feedbackCard) {
                        const cardContainer = feedbackCard.closest('.col-xl-4');
                        if (cardContainer) {
                            cardContainer.remove();
                            
                            // Check if there are no more feedback cards
                            const cardsContainer = document.querySelector('.feedback-cards-container .row');
                            if (cardsContainer && cardsContainer.children.length === 0) {
                                cardsContainer.innerHTML = `
                                    <div class="col-12">
                                        <div class="empty-state">
                                            <i class="fas fa-comment-alt"></i>
                                            <p>No feedback messages found</p>
                                        </div>
                                    </div>
                                `;
                            }
                        }
                    }
                }
                
                // Show success message in top-right corner
                Swal.fire({
                    icon: 'success',
                    title: modalTitle,
                    text: modalText,
                    timer: 2000,
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timerProgressBar: true
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.message || 'Failed to process feedback.',
                    toast: true,
                    position: 'top-end',
                    timer: 3000,
                    timerProgressBar: true,
                    showConfirmButton: false
                });
            }
        })
        .catch(error => {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'An error occurred while updating the status.',
                toast: true,
                position: 'top-end',
                timer: 3000,
                timerProgressBar: true,
                showConfirmButton: false
            });
        });
    });

    // Reply functionality
    document.getElementById("contactReplyBtn").addEventListener("click", function() {
        // In a real app, this would open an email client or reply form
        const email = document.getElementById("contactViewEmail").textContent;
        const subject = "Re: " + document.getElementById("contactViewSubject").textContent;
        alert(`Reply to: ${email}\nSubject: ${subject}`);
    });
    
    // Cards search functionality
    $(document).ready(function() {
        // Clear search button functionality
        $(".search-clear-btn").on("click", function() {
            $("#pmSearchInput").val("").trigger("input");
            // Show all cards
            $(".card-grid-item").show();
        });
        
        // Search input functionality
        $("#pmSearchInput").on("input", function() {
            var searchTerm = $(this).val().toLowerCase();
            
            // Filter cards based on search term
            $(".card-grid-item").each(function() {
                var cardText = $(this).text().toLowerCase();
                var cardName = $(this).find(".product-title").text().toLowerCase();
                var cardCategory = $(this).data("category").toLowerCase();
                
                if (cardText.includes(searchTerm) || cardName.includes(searchTerm) || cardCategory.includes(searchTerm)) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        });
        
        // Category filter functionality
        $("#cardCategoryFilter").on("change", function() {
            filterCards();
        });
        
        // Stock filter functionality
        $("#cardStockFilter").on("change", function() {
            filterCards();
        });
        
        function filterCards() {
            const searchTerm = $("#pmSearchInput").val().toLowerCase();
            const categoryFilter = $("#cardCategoryFilter").val().toLowerCase();
            const stockFilter = $("#cardStockFilter").val().toLowerCase();
            
            $(".card-grid-item").each(function() {
                const cardText = $(this).text().toLowerCase();
                const cardName = $(this).find(".product-title").text().toLowerCase();
                const cardCategory = $(this).data("category").toLowerCase();
                const cardStock = $(this).data("stock").toLowerCase();
                
                const matchesSearch = searchTerm === "" || cardText.includes(searchTerm) || cardName.includes(searchTerm) || cardCategory.includes(searchTerm);
                const matchesCategory = categoryFilter === "" || cardCategory === categoryFilter;
                const matchesStock = stockFilter === "" || cardStock === stockFilter;
                
                if (matchesSearch && matchesCategory && matchesStock) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }
    });
</script>


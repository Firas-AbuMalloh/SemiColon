                                                                        <img src="~/assets/images/profile/@user.ProfileImageUrl" alt="@user.Username" class="rounded-circle" width="40" height="40">
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="default-avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                                            @(user.FirstName != null && user.FirstName.Length > 0 ? user.FirstName[0].ToString().ToUpper() : "U")

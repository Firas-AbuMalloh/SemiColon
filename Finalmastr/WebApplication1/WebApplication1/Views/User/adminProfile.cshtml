    function populateOrderMetadata(metadata) {
        if (!metadata) return;
        
        // Order date
        if (metadata.orderDate) {
            var formattedDate = new Date(metadata.orderDate).toLocaleDateString('en-US', { 
                year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' 
            });
            $("#modalOrderDate").text(formattedDate);
            $("#invoiceOrderDate").text(formattedDate);
        }
        
        // Order status
        if (metadata.status) {
            var statusClass = '';
            switch(metadata.status) {
                case "Pending": statusClass = "bg-warning"; break;
                case "Processing": statusClass = "bg-info"; break;
                case "Shipped": statusClass = "bg-primary"; break;
                case "Delivered": statusClass = "bg-success"; break;
                case "Completed": statusClass = "bg-success"; break;
                case "Cancelled": statusClass = "bg-danger"; break;
                default: statusClass = "bg-secondary";
            }
            $("#invoiceOrderStatus").addClass(statusClass).text(metadata.status);
        }
        
        // Customer information
        if (metadata.customer) {
            $("#customerName").text(metadata.customer.name || "N/A");
            $("#customerEmail").text(metadata.customer.email || "Email not available");
            $("#customerPhone").text(metadata.customer.phone || "Phone not available");
        }
    }
    
    function generatePDF() {
        // Show loading state
        var $downloadBtn = $("#downloadInvoiceBtn");
        var originalText = $downloadBtn.html();
        $downloadBtn.prop("disabled", true).html('<i class="fas fa-spinner fa-spin"></i> Generating...');
        $("#downloadInvoiceBtn2").prop("disabled", true).html('<i class="fas fa-spinner fa-spin"></i> Generating...');
        
        // Make sure the html2pdf library is loaded
        if (typeof html2pdf === 'undefined') {
            console.error("html2pdf library not loaded. Loading it now...");
            // Dynamically load the html2pdf library
            var script = document.createElement('script');
            script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
            script.onload = function() {
                console.log("html2pdf library loaded successfully");
                // Continue with PDF generation
                proceedWithPDFGeneration();
            };
            script.onerror = function() {
                console.error("Failed to load html2pdf library");
                $downloadBtn.prop("disabled", false).html(originalText);
                $("#downloadInvoiceBtn2").prop("disabled", false).html(originalText);
                alert("Failed to load PDF generation library. Please try again later.");
            };
            document.head.appendChild(script);
        } else {
            // Library already loaded, proceed directly
            proceedWithPDFGeneration();
        }
        
        function proceedWithPDFGeneration() {
            // Clone the invoice content for printing
            var invoiceContent = $("#invoiceContent").clone();
            
            // Get order data
            var orderId = $("#invoiceOrderId").text();
            var orderDate = $("#invoiceOrderDate").text();
            
            // Use html2pdf library to generate PDF
            convertToPDF(invoiceContent, orderId, orderDate);
        }
    }
    
    function convertToPDF(content, orderId, orderDate) {
        try {
            console.log("Starting PDF generation for order:", orderId);
            
            // Store original button text for restoration later
            var originalBtnText = $("#downloadInvoiceBtn").html();
            
            // Create a container for the PDF content
            var element = document.createElement('div');
            element.innerHTML = content.html();
            
            // Ensure all styles are applied
            element.className = "invoice-container pdf-container";
            element.style.padding = "20px";
            element.style.backgroundColor = "#fff";
            element.style.maxWidth = "100%";
            element.style.fontFamily = "Arial, sans-serif";
            
            console.log("Processing images in invoice content");
            
            // Fix product images paths
            $(element).find('.invoice-item img').each(function() {
                var originalSrc = $(this).attr('src');
                console.log("Original product image src:", originalSrc);
                
                // Use a default image if the path contains template literals that weren't processed
                if (originalSrc && (originalSrc.includes('${') || originalSrc.includes('||'))) {
                    console.log("Found unprocessed template in image path, using default");
                    $(this).attr('src', window.location.origin + '/assets/images/product/default.jpg');
                } 
                // Otherwise ensure the path is absolute
                else if (originalSrc) {
                    // First handle tilde path
                    if (originalSrc.startsWith('~/')) {
                        originalSrc = originalSrc.replace('~/', '/');
                    }
                    
                    // Add domain to relative paths
                    if (originalSrc.startsWith('/')) {
                        // Ensure we have the full domain
                        $(this).attr('src', window.location.origin + originalSrc);
                    } else if (!originalSrc.startsWith('http')) {
                        // For relative paths without leading slash
                        $(this).attr('src', window.location.origin + '/' + originalSrc);
                    }
                } else {
                    // No src attribute found, use default
                    $(this).attr('src', window.location.origin + '/assets/images/product/default.jpg');
                }
                
                console.log("Updated product image src:", $(this).attr('src'));
            });
            
            // Fix logo and other static images
            $(element).find('img:not(.invoice-item img)').each(function() {
                var originalSrc = $(this).attr('src');
                console.log("Original static image src:", originalSrc);
                
                if (originalSrc) {
                    // First handle tilde path
                    if (originalSrc.startsWith('~/')) {
                        originalSrc = originalSrc.replace('~/', '/');
                    }
                    
                    // Add domain to relative paths
                    if (originalSrc.startsWith('/')) {
                        // Ensure we have the full domain
                        $(this).attr('src', window.location.origin + originalSrc);
                    } else if (!originalSrc.startsWith('http')) {
                        // For relative paths without leading slash
                        $(this).attr('src', window.location.origin + '/' + originalSrc);
                    }
                    
                    console.log("Updated static image src:", $(this).attr('src'));
                }
            });
            
            // Remove unnecessary elements that might cause issues
            $(element).find('.modal-actions, .action-buttons, .dropdown-menu').remove();
            
            // Clean up any styles that might interfere with PDF rendering
            $(element).find('*').each(function() {
                // Remove hover and transition styles
                if (this.style) {
                    this.style.transition = 'none';
                    this.style.boxShadow = 'none';
                }
            });
            
            // Set up PDF options with improved settings
            var opt = {
                margin: [0.5, 0.5, 0.5, 0.5],
                filename: 'invoice-order-' + orderId + '.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { 
                    scale: 2, 
                    useCORS: true,
                    letterRendering: true,
                    allowTaint: true,
                    logging: false, // Disable logging
                    backgroundColor: '#FFFFFF',  // Set background color
                    onrendered: function(canvas) {
                        console.log("Canvas rendering complete");
                    }
                },
                jsPDF: { 
                    unit: 'in', 
                    format: 'letter', 
                    orientation: 'portrait',
                    compress: true
                }
            };
            
            // Add element to document temporarily
            document.body.appendChild(element);
            console.log("Added PDF content to document for rendering");
            
            // Generate PDF
            console.log("Starting html2pdf conversion");
            html2pdf()
                .from(element)
                .set(opt)
                .save()
                .then(function() {
                    console.log("PDF generated successfully");
                    // Reset download buttons
                    $("#downloadInvoiceBtn, #downloadInvoiceBtn2").prop("disabled", false).html(originalBtnText);
                    
                    // Clean up
                    if (element && element.parentNode) {
                        document.body.removeChild(element);
                    }
                })
                .catch(function(error) {
                    console.error("PDF generation error:", error);
                    // Reset download buttons
                    $("#downloadInvoiceBtn, #downloadInvoiceBtn2").prop("disabled", false).html(originalBtnText);
                    // Show error message
                    alert("There was an error generating the PDF. Please try again.");
                    
                    // Clean up
                    if (element && element.parentNode) {
                        document.body.removeChild(element);
                    }
                });
        } catch (e) {
            console.error("Exception in PDF generation:", e);
            // Reset download buttons in case of error
            $("#downloadInvoiceBtn, #downloadInvoiceBtn2").prop("disabled", false).html(originalBtnText || "Download Invoice");
            alert("An unexpected error occurred while generating the PDF. Please try again later.");
        }
    }
    
    // Function to load order details and show modal
    function loadOrderDetails(orderId) {
        console.log("Loading order details for order ID:", orderId);
        
        // Reset and show modal
        resetOrderModal();
        $("#modalOrderId").text(orderId);
        $("#invoiceOrderId").text(orderId);
        $("#barcode-order-id").text(orderId);
        
        // Initialize the modal if it's not already done
        var orderModalElement = document.getElementById('orderDetailsModal');
        var orderModal = new bootstrap.Modal(orderModalElement, {
            keyboard: true,
            focus: true
        });
        
        // Set up modal hidden event handler to clean up properly
        $(orderModalElement).off('hidden.bs.modal');
        $(orderModalElement).on('hidden.bs.modal', function () {
            // Clean up after modal is hidden
            resetOrderModal();
            
            // Restore document scroll behavior
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
            
            // Remove any lingering backdrop
            const backdrop = document.querySelector('.modal-backdrop');
            if (backdrop) {
                backdrop.remove();
            }
            
            // Reset any floating elements
            const modalOpen = document.querySelector('.modal-open');
            if (modalOpen) {
                modalOpen.classList.remove('modal-open');
            }
            
            console.log("Modal cleanup complete");
        });
        
        // Show the modal
        orderModal.show();
        
        // Show loading indicator
        $("#orderLoading").show();
        $("#invoiceContent").hide();
        $("#orderError").addClass("d-none");
        
        // Fetch order details
        $.ajax({
            url: '/User/GetOrderDetails',
            type: 'GET',
            data: { orderId: orderId },
            success: function(data) {
                handleOrderDetailsSuccess(data, orderId);
            },
            error: function() {
                handleOrderDetailsError();
            }
        });
        
        // Additional request to get order metadata
        $.ajax({
            url: '/User/GetOrderMetadata',
            type: 'GET',
            data: { orderId: orderId },
            success: function(metadata) {
                populateOrderMetadata(metadata);
            },
            error: function() {
                // Silently handle this error, the UI can still function without metadata
                console.log("Failed to load order metadata");
            }
        });
    }
    

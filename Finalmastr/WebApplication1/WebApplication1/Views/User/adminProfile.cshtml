		const price = document.getElementById("pmPrice").value;
		const stockQuantity = document.getElementById("pmStockQuantity").value;
		const categoryId = document.getElementById("pmCategoryId").value;
		const sellerId = document.getElementById("pmSellerId").value;
		const description = document.getElementById("pmDescription").value;
		const imageUrl = document.getElementById("pmImageUrl").value;

		// Validate form data
		if (!cardName) {
			Swal.fire({
				icon: 'error',
				title: 'Error',
				text: 'Card name is required.'
			});
			return false;
		}

		if (!price || isNaN(price) || price <= 0) {
			Swal.fire({
				icon: 'error',
				title: 'Error',
				text: 'Please enter a valid price.'
			});
			return false;
		}

		if (!stockQuantity || isNaN(stockQuantity) || stockQuantity < 0) {
			Swal.fire({
				icon: 'error',
				title: 'Error',
				text: 'Please enter a valid stock quantity.'
			});
			return false;
		}

		if (!categoryId) {
			Swal.fire({
				icon: 'error',
				title: 'Error',
				text: 'Please select a category.'
			});
			return false;
		}


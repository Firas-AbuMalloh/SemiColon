                                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                                    <div class="stat-card-title text-success">Total Revenue</div>
                                                                    <div class="stat-card-icon">
                                                                        <i class="fas fa-dollar-sign text-gray-300"></i>
                                                                    </div>
                                                                </div>

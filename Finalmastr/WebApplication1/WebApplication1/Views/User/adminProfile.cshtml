                                                                    <div class="stat-card-icon">
                                                                        <i class="fas fa-shopping-cart text-gray-300"></i>
                                                                    </div>
                                                                </div>
                                                                <div class="stat-card-value h3 mb-0">@activeCartsCount</div>
                                                                <div class="stat-card-details small mt-2">
                                                                    <span>Value: $@totalCartValue.ToString("N2")</span>

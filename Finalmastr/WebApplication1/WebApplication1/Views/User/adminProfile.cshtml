                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                row.remove();
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted!',
                                    text: data.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                });
            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: data.message
                                });
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'An error occurred while deleting the blog.'
        });
    });
                    }
                });
            });
        });
        
        // Form submission
        if (blogForm) {
            blogForm.addEventListener("submit", function(e) {
                e.preventDefault();
                
                // Get form data
                const blogId = document.getElementById("blogId").value;
                const title = document.getElementById("blogTitle").value;
                const content = document.getElementById("blogContent").value;
                
                // Validate inputs
                if (!title) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Blog title is required.'
                    });
                    return false;
                }
                
                if (!content) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Blog content is required.'
                    });
                    return false;
                }
                
                // Create form data
                const formData = new FormData();
                
                if (isEditMode) {
                    formData.append('id', blogId);
                }
                
                formData.append('title', title);
                formData.append('content', content);
                
                // Determine URL based on mode
                const url = isEditMode ? '/User/updateBlog' : '/User/addBlog';
                
                // Send request
                fetch(url, {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: data.message,
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            // Reload page to show updated data
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: data.message || 'An error occurred while saving the blog.'
                        });
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An error occurred while saving the blog.'
        });
    });
            });
        }
        
        // Search and filtering
        function filterBlogs() {
            const searchTerm = blogSearchInput ? blogSearchInput.value.toLowerCase() : "";
            const authorFilter = blogAuthorFilter ? blogAuthorFilter.value : "";
            const dateFilter = blogDateFilter ? blogDateFilter.value : "";
            
            const rows = blogTable ? blogTable.querySelectorAll("tbody tr") : [];
            let visibleCount = 0;

        const today = new Date();
        today.setHours(0, 0, 0, 0);

        const weekStart = new Date(today);
        weekStart.setDate(today.getDate() - today.getDay());

        const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
            
            const yearStart = new Date(today.getFullYear(), 0, 1);

        rows.forEach(row => {
                const rowText = row.textContent.toLowerCase();
                const authorId = row.getAttribute("data-author-id");
                const createdDateStr = row.getAttribute("data-created");
                let createdDate = null;
                
                if (createdDateStr) {
                    createdDate = new Date(createdDateStr);
                    createdDate.setHours(0, 0, 0, 0);
                }
                
                const matchesSearch = searchTerm === "" || rowText.includes(searchTerm);
                const matchesAuthor = authorFilter === "" || authorId === authorFilter;
                
                let matchesDate = true;
                if (dateFilter && createdDate) {
            if (dateFilter === "today") {
                        matchesDate = createdDate.getTime() === today.getTime();
            } else if (dateFilter === "week") {
                        matchesDate = createdDate >= weekStart;
            } else if (dateFilter === "month") {
                        matchesDate = createdDate >= monthStart;
                    } else if (dateFilter === "year") {
                        matchesDate = createdDate >= yearStart;
                    }
                }
                
                const shouldShow = matchesSearch && matchesAuthor && matchesDate;
                
                row.style.display = shouldShow ? "" : "none";
                
                if (shouldShow) {
                    visibleCount++;
                }
            });
            
            // Show empty state if no results
            const existingEmptyState = blogTable ? blogTable.querySelector(".blog-empty-state") : null;
            
            if (visibleCount === 0 && blogTable) {
                if (!existingEmptyState) {
                    const emptyState = document.createElement("tr");
                    emptyState.className = "blog-empty-state";
                    emptyState.innerHTML = `
                        <td colspan="6">
                            <div class="empty-state">
                                <i class="fas fa-search"></i>
                                <p>No blogs found matching your filters</p>
                                <button class="blog-btn blog-btn-primary" id="resetBlogFiltersBtn">
                                    <i class="fas fa-times"></i> Reset Filters
                                </button>
                            </div>
                        </td>
                    `;
                    blogTable.querySelector("tbody").appendChild(emptyState);
                    
                    // Add reset button functionality
                    document.getElementById("resetBlogFiltersBtn").addEventListener("click", function() {
                        if (blogSearchInput) blogSearchInput.value = "";
                        if (blogAuthorFilter) blogAuthorFilter.value = "";
                        if (blogDateFilter) blogDateFilter.value = "";
                        filterBlogs();
                    });
                }
            } else if (existingEmptyState) {
                existingEmptyState.remove();
            }
        }
        
        // Add event listeners for search and filters
        if (blogSearchInput) {
            blogSearchInput.addEventListener("input", filterBlogs);
        }
        
        if (blogAuthorFilter) {
            blogAuthorFilter.addEventListener("change", filterBlogs);
        }
        
        if (blogDateFilter) {
            blogDateFilter.addEventListener("change", filterBlogs);
        }
    });
</script>

<!-- Initialize Feedback Management Functions -->
<script>
    // Initialize feedback functionality when document is ready
    $(document).ready(function() {
        // Tab click handler to ensure buttons are bound when the tab becomes visible
        $('a[data-bs-toggle="tab"][href="#nav-feedBack"]').on('shown.bs.tab', function() {
            initializeFeedbackFunctions();
        });
        
        // Also initialize on page load in case the feedback tab is active by default
        if ($('#nav-feedBack').hasClass('active')) {
            initializeFeedbackFunctions();
        }
        
        // Close modal functionality
        $('#contactCloseBtn').on('click', function() {
            $('#contactViewModal').hide();
        });
        
        // Close modal when clicking on the X
        $('.contact-modal-close').on('click', function() {
            $('#contactViewModal').hide();
        });
        
        // Initialize feedback publish button
        $('#contactPublishBtn').on('click', function() {
            // Get the feedback ID
            const feedbackId = $('#viewFeedbackId').val();
            
            if (!feedbackId) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Could not identify feedback item.'
                });
                return;
            }
            
            // Send request to toggle status
            $.ajax({
                url: '/User/toggleFeedbackStatus',
                type: 'POST',
                data: { id: feedbackId },
                success: function(data) {
                    if (data.success) {
                        const modalTitle = data.isPublished ? "Testimonial Published" : "Status Updated";
                        const modalText = data.message;
                        
                        Swal.fire({
                            icon: 'success',
                            title: modalTitle,
                            text: modalText,
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            // Close the modal
                            $('#contactViewModal').hide();
                            
                            // If published (moved to Testimonials), remove the row
                            if (data.isPublished) {
                                $(`tr[data-id="${feedbackId}"]`).remove();
                            } else {
                                // Just update the status display
                                const feedbackRow = $(`tr[data-id="${feedbackId}"]`);
                                if (feedbackRow.length) {
                                    const statusCell = feedbackRow.find('td:nth-child(8) span');
                                    if (statusCell.length) {
                                        statusCell.text("Unpublished");
                                        statusCell.removeClass("contact-badge-published").addClass("contact-badge-unpublished");
                                    }
                                }
                            }
                            
                            // Check if there are no more rows and show empty state if needed
                            checkEmptyFeedbackTable();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: data.message
                        });
                    }
                },
                error: function(error) {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An error occurred while updating the status.'
                    });
                }
            });
        });
    });
    
    // Function to initialize all feedback-related event handlers
    function initializeFeedbackFunctions() {
        console.log('Initializing feedback functions');
        
                 // View button functionality
         $('.contact-view-btn').off('click').on('click', function() {
             const id = $(this).attr('data-id');
             const name = $(this).attr('data-name');
             const email = $(this).attr('data-email');
             const phone = $(this).attr('data-phone');
             const subject = $(this).attr('data-subject');
             const message = $(this).attr('data-message');
             const date = $(this).attr('data-date');
             const status = $(this).attr('data-status');
            
            // Store ID in hidden field
            $('#viewFeedbackId').val(id);
            
            // Populate the modal fields
            $('#contactViewName').text(name);
            $('#contactViewEmail').text(email);
            $('#contactViewPhone').text(phone || 'Not provided');
            $('#contactViewSubject').text(subject);
            $('#contactViewDate').text(date);
            $('#contactViewMessage').text(message);
            
            // Update status display
            const statusElement = $('#contactViewStatus');
            statusElement.text(status);
            if (status.includes('Published')) {
                statusElement.removeClass('contact-badge-unpublished').addClass('contact-badge-published');
                $('#contactPublishBtn').html('<i class="fas fa-times-circle"></i> Unpublish');
            } else {
                statusElement.removeClass('contact-badge-published').addClass('contact-badge-unpublished');
                $('#contactPublishBtn').html('<i class="fas fa-check-circle"></i> Publish as Testimonial');
            }
            
            // Show the modal
            $('#contactViewModal').show();
        });
        
                 // Delete button functionality
         $('.contact-delete-btn').off('click').on('click', function() {
             const feedbackId = $(this).attr('data-id');
             const row = $(this).closest('tr');
            
            Swal.fire({
                title: 'Are you sure?',
                text: 'You are about to delete this feedback message. This action cannot be undone!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                // Remove visual indication regardless of the choice
                $(this).removeClass('deleting');
                
                if (result.isConfirmed) {
                    // Add loading animation to the row
                    row.addClass('deleting-row');
                    
                    // Send delete request to server
                    $.ajax({
                        url: '/User/deleteFeedback',
                        type: 'POST',
                        data: { id: feedbackId },
                        success: function(data) {
                            if (data.success) {
                                // Fade out animation
                                row.css({
                                    'animation': 'fadeOut 0.5s ease forwards'
                                });
                                
                                // Remove row after animation completes
                                setTimeout(function() {
                                    row.remove();
                                    
                                    // Update stats with animation
                                    const totalCount = $('#totalFeedbackCount');
                                    if (totalCount.length) {
                                        const currentCount = parseInt(totalCount.text());
                                        totalCount.text(currentCount - 1);
                                        totalCount.addClass('stat-updated');
                                        setTimeout(() => totalCount.removeClass('stat-updated'), 1000);
                                    }
                                    
                                    // Check if there are no more rows and show empty state if needed
                                    checkEmptyFeedbackTable();
                                    
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Deleted!',
                                        text: data.message || 'Feedback deleted successfully.',
                                        timer: 1500,
                                        timerProgressBar: true,
                                        showConfirmButton: false
                                    });
                                }, 500);
                            } else {
                                // Remove animation class
                                row.removeClass('deleting-row');
                                
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: data.message || 'An error occurred.'
                                });
                            }
                        },
                        error: function(error) {
                            // Remove animation class
                            row.removeClass('deleting-row');
                            
                            console.error('Error:', error);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'An error occurred while deleting the feedback.'
                            });
                        }
                    });
                }
            });
        });
        
        // Initialize feedback filters
        $('#contactStatusFilter, #contactDateFilter').off('change').on('change', function() {
            applyFeedbackFilters();
        });
        
        $('#contactSearchInput').off('input').on('input', function() {
            applyFeedbackFilters();
        });
        
        // Filter button click
        $('.contact-filter-container .contact-btn-primary').off('click').on('click', function() {
            applyFeedbackFilters();
        });
    }
    
    // Function to apply filters to feedback table
    function applyFeedbackFilters() {
        const statusFilter = $('#contactStatusFilter').val();
        const dateFilter = $('#contactDateFilter').val();
        const searchTerm = $('#contactSearchInput').val().toLowerCase();
        const rows = $('#contactTable tbody tr.feedback-row');
        
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        
        const weekStart = new Date(today);
        weekStart.setDate(today.getDate() - today.getDay());
        
        const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
        
        let visibleCount = 0;
        
        rows.each(function() {
            const $row = $(this);
            const status = $row.find('td:nth-child(8)').text().toLowerCase();
            const dateStr = $row.attr('data-created');
            let messageDate = null;
            
            if (dateStr) {
                messageDate = new Date(dateStr);
                messageDate.setHours(0, 0, 0, 0);
            }
            
            const name = $row.find('td:nth-child(2)').text().toLowerCase();
            const email = $row.find('td:nth-child(3)').text().toLowerCase();
            const subject = $row.find('td:nth-child(5)').text().toLowerCase();
            const message = $row.find('td:nth-child(6)').text().toLowerCase();
            
            // Apply status filter
            const statusMatch = statusFilter === "all" ||
                             (statusFilter === "published" && status.includes("published")) ||
                             (statusFilter === "unpublished" && status.includes("unpublished"));
            
            // Apply date filter
            let dateMatch = true;
            if (dateFilter !== "all" && messageDate) {
                if (dateFilter === "today") {
                    dateMatch = messageDate.getTime() === today.getTime();
                } else if (dateFilter === "week") {
                    dateMatch = messageDate >= weekStart;
                } else if (dateFilter === "month") {
                    dateMatch = messageDate >= monthStart;
                }
            }
            
            // Apply search filter
            const searchMatch = searchTerm === "" ||
                             name.includes(searchTerm) ||
                             email.includes(searchTerm) ||
                             subject.includes(searchTerm) ||
                             message.includes(searchTerm);
            
            // Show/hide based on all filters
            const shouldShow = statusMatch && dateMatch && searchMatch;
            $row.toggle(shouldShow);
            
            if (shouldShow) {
                visibleCount++;
            }
        });
        
        // Show empty state if no results
        checkEmptyFeedbackTable(visibleCount);
    }
    
    // Function to check if the feedback table is empty and show appropriate message
    function checkEmptyFeedbackTable(visibleCount) {
        const tableBody = $('#contactTable tbody');
        const existingEmptyState = tableBody.find('.feedback-empty-state');
        
        // If visibleCount is undefined, count visible rows
        if (typeof visibleCount === 'undefined') {
            visibleCount = tableBody.find('tr.feedback-row:visible').length;
        }
        
        if (visibleCount === 0) {
            if (existingEmptyState.length === 0) {
                const emptyRow = $(`
                    <tr class="feedback-empty-state" style="opacity: 0;">
                        <td colspan="9">
                            <div class="empty-state">
                                <i class="fas fa-comment-alt"></i>
                                <p>No feedback messages found</p>
                            </div>
                        </td>
                    </tr>
                `);
                
                tableBody.append(emptyRow);
                
                // Fade in animation
                setTimeout(function() {
                    emptyRow.css({
                        'transition': 'opacity 0.5s ease',
                        'opacity': 1
                    });
                }, 10);
            } else {
                existingEmptyState.show();
            }
        } else if (existingEmptyState.length > 0) {
            existingEmptyState.hide();
        }
    }
</script>


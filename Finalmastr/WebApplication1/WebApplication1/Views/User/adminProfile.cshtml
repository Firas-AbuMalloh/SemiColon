<!-- Add Discount Management JavaScript -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
    // DOM Elements
    const discountModal = document.getElementById("discountModal");
    const discountAddBtn = document.getElementById("discountAddBtn");
    const discountModalClose = document.querySelector(".discount-modal-close");
    const discountCancelBtn = document.getElementById("discountCancelBtn");
    const discountForm = document.getElementById("discountForm");
    const discountModalTitle = document.getElementById("discountModalTitle");
    const discountSearchInput = document.getElementById("discountSearchInput");
    const discountTable = document.getElementById("discountTable");
        const discountTypeFilter = document.getElementById("discountTypeFilter");
        const discountStatusFilter = document.getElementById("discountStatusFilter");
        
        // Hidden field for discount ID
        let currentDiscountId = 0;
        let isEditMode = false;

    // Open modal for adding new discount
        discountAddBtn.onclick = function() {
        discountModalTitle.textContent = "Add New Discount";
        discountForm.reset();
            document.getElementById("discountId").value = "0";
            currentDiscountId = 0;
            isEditMode = false;
            
        discountModal.style.display = "block";
        }

        // Close modal functions
        function closeDiscountModal() {
        discountModal.style.display = "none";
    }

        discountModalClose.onclick = closeDiscountModal;
        discountCancelBtn.onclick = closeDiscountModal;
        
        // Click outside to close
        window.addEventListener('click', function(event) {
            if (event.target == discountModal) {
                closeDiscountModal();
            }
        });
        
        // Edit discount function
    document.querySelectorAll(".discount-edit-btn").forEach(btn => {
            btn.onclick = function() {
                const discountId = this.getAttribute('data-discount-id');
            discountModalTitle.textContent = "Edit Discount";
                isEditMode = true;
                currentDiscountId = discountId;
                
                // Fetch discount details
                fetch(`/User/getDiscountDetails?id=${discountId}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Fill the form with discount data
                            document.getElementById("discountId").value = data.id;
                            document.getElementById("discountCode").value = data.code;
                            document.getElementById("discountDescription").value = data.description || "";
                            document.getElementById("discountValue").value = data.value;
                            document.getElementById("discountType").value = data.isPercentage.toString();
                            document.getElementById("discountStatus").value = data.isActive.toString();
                            
                            // Set dates if available
                            if (data.startDate) {
                                document.getElementById("discountStartDate").value = data.startDate;
                            }
                            
                            if (data.endDate) {
                                document.getElementById("discountEndDate").value = data.endDate;
                            }
                            
                            document.getElementById("discountUsageLimit").value = data.usageLimit || "";
                            
                            // Set applicable to
                            const applicableTo = document.getElementById("discountApplicableTo");
                            if (data.applicableToUser) {
                                applicableTo.value = "specific";
                            } else {
                                applicableTo.value = "all";
                            }
                            
                            // Show the modal
            discountModal.style.display = "block";
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Failed to load discount details.'
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An error occurred while fetching discount details.'
                        });
                    });
            };
        });
        
        // Delete discount function
        document.querySelectorAll(".discount-delete-btn").forEach(btn => {
            btn.onclick = function(e) {
                e.preventDefault();
                const discountId = this.getAttribute('data-discount-id');
                const row = this.closest('tr');
                
                Swal.fire({
                    title: 'Are you sure?',
                    text: 'You are about to delete this discount code. This action cannot be undone!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete it!',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Send delete request
                        fetch(`/User/deleteDiscount?id=${discountId}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                row.remove();
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted!',
                                    text: data.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: data.message
                                });
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'An error occurred while deleting the discount.'
                            });
                        });
                    }
                });
            };
        });
        
        // Form submission
        discountForm.onsubmit = function(e) {
            e.preventDefault();
            
            // Get form data
            const discountId = document.getElementById("discountId").value;
            const discountCode = document.getElementById("discountCode").value;
            const description = document.getElementById("discountDescription").value;
            const discountValue = document.getElementById("discountValue").value;
            const isPercentage = document.getElementById("discountType").value === "true";
            const isActive = document.getElementById("discountStatus").value === "true";
            const startDate = document.getElementById("discountStartDate").value;
            const endDate = document.getElementById("discountEndDate").value;
            const usageLimit = document.getElementById("discountUsageLimit").value || null;
            const applicableTo = document.getElementById("discountApplicableTo").value;
            
            // Validate inputs
            if (!discountCode) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Discount code is required.'
                });
                return false;
            }
            
            if (!discountValue || isNaN(discountValue) || discountValue <= 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Please enter a valid discount value.'
                });
                return false;
            }
            
            // Create form data
            const formData = new FormData();
            if (isEditMode) {
                formData.append('id', discountId);
            }
            formData.append('discountCode', discountCode);
            formData.append('description', description);
            formData.append('discountValue', discountValue);
            formData.append('isPercentage', isPercentage);
            formData.append('startDate', startDate);
            formData.append('endDate', endDate);
            formData.append('usageLimit', usageLimit);
            formData.append('isActive', isActive);
            
            // Handle applicable to
            if (applicableTo === "specific") {
                formData.append('applicableToUser', 1); // Just a placeholder, would need user selection in real app
                formData.append('applicableToCart', false);
            } else {
                formData.append('applicableToUser', null);
                formData.append('applicableToCart', false);
            }
            
            // Determine URL based on mode
            const url = isEditMode ? '/User/updateDiscount' : '/User/addDiscount';
            
            // Send request
            fetch(url, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: data.message,
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        // Reload page to show updated data
                        location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message || 'An error occurred while saving the discount.'
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'An error occurred while saving the discount.'
        });
    });

            return false;
        };
        
        // Search and filtering
        function filterDiscounts() {
            const searchTerm = discountSearchInput.value.toLowerCase();
            const typeFilter = discountTypeFilter.value.toLowerCase();
            const statusFilter = discountStatusFilter.value.toLowerCase();
            
        const rows = discountTable.querySelectorAll("tbody tr");
            let visibleCount = 0;

        rows.forEach(row => {
                const rowText = row.textContent.toLowerCase();
                const rowType = row.getAttribute("data-type");
                const rowStatus = row.getAttribute("data-status");
                
                const matchesSearch = searchTerm === "" || rowText.includes(searchTerm);
                const matchesType = typeFilter === "" || rowType === typeFilter;
                const matchesStatus = statusFilter === "" || rowStatus === statusFilter;
                
                const shouldShow = matchesSearch && matchesType && matchesStatus;
                
                row.style.display = shouldShow ? "" : "none";
                
                if (shouldShow) {
                    visibleCount++;
                }
            });
            
            // Show empty state if no results
            const existingEmptyState = document.querySelector(".discount-empty-state");
            
            if (visibleCount === 0) {
                if (!existingEmptyState) {
                    const emptyState = document.createElement("tr");
                    emptyState.className = "discount-empty-state";
                    emptyState.innerHTML = `
                        <td colspan="11">
                            <div class="empty-state">
                                <i class="fas fa-search"></i>
                                <p>No discounts found matching your filters</p>
                                <button class="discount-btn discount-btn-primary" id="resetFiltersBtn">
                                    <i class="fas fa-times"></i> Reset Filters
                                </button>
                            </div>
                        </td>
                    `;
                    discountTable.querySelector("tbody").appendChild(emptyState);
                    
                    // Add reset button functionality
                    document.getElementById("resetFiltersBtn").addEventListener("click", function() {
                        discountSearchInput.value = "";
                        if (discountTypeFilter) discountTypeFilter.value = "";
                        if (discountStatusFilter) discountStatusFilter.value = "";
                        filterDiscounts();
                    });
                }
            } else if (existingEmptyState) {
                existingEmptyState.remove();
            }
        }
    });
</script>


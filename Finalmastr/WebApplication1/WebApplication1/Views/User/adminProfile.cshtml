<script>
    $(document).ready(function() {
        // تفعيل زر "Read More" في بطاقات الملاحظات
        $(document).on('click', '.read-more', function() {
            var messageContainer = $(this).closest('.feedback-message');
            var fullMessage = $(this).data('full-message') || $(this).parent().text().replace('... Read More', '');
            
            messageContainer.html('<p>' + fullMessage + '</p>');
        });
        
        // تحسين تفاعل المستخدم عند الضغط على أزرار الحذف
        $(document).on('click', '.feedback-action-delete', function() {
            $(this).addClass('deleting');
            setTimeout(() => $(this).removeClass('deleting'), 800);
        });
    });
</script>

<script>

    // Delete testimonial functionality
    document.querySelectorAll(".delete-testimonial-btn").forEach(btn => {
        btn.addEventListener("click", function() {
            const testimonialId = this.getAttribute('data-id');
            const testimonialCard = this.closest(".testimonial-item");
            
            Swal.fire({
                title: 'Delete Testimonial?',
                text: 'Are you sure you want to delete this testimonial? This action cannot be undone!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Send delete request to server
                    fetch(`/User/deleteTestimonial?id=${testimonialId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Remove the testimonial card
                            testimonialCard.remove();
                            
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: data.message || 'Testimonial has been deleted.',
                                timer: 2000,
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timerProgressBar: true
                            });
                            
                            // Check if there are no more testimonials and show empty state if needed
                            const testimonialsGrid = document.querySelector('.testimonials-grid .row');
                            if (testimonialsGrid && testimonialsGrid.children.length === 0) {
                                testimonialsGrid.innerHTML = `
                                    <div class="col-12 testimonial-empty-state">
                                        <div class="empty-state">
                                            <i class="fas fa-quote-right"></i>
                                            <p>No testimonials found</p>
                                        </div>
                                    </div>
                                `;
                            }
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'An error occurred while deleting the testimonial.',
                                toast: true,
                                position: 'top-end',
                                timer: 3000,
                                timerProgressBar: true,
                                showConfirmButton: false
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An error occurred while deleting the testimonial.',
                            toast: true,
                            position: 'top-end',
                            timer: 3000,
                            timerProgressBar: true,
                            showConfirmButton: false
                        });
                    });
                }
            });
        });
    });

    // Update the toggleFeedbackStatus function to hide feedback card when published as testimonial
    document.getElementById("contactPublishBtn").addEventListener("click", function() {
        // Get the feedback ID
        const feedbackId = document.getElementById("viewFeedbackId").value;
        
        if (!feedbackId) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Could not identify feedback item.'
            });
            return;
        }
        
        // Send request to toggle status
        fetch(`/User/toggleFeedbackStatus?id=${feedbackId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const statusElement = document.getElementById("contactViewStatus");
                const modalTitle = data.isPublished ? "Testimonial Published" : "Status Updated";
                const modalText = data.message;
                
                // Close the modal first
                document.getElementById("contactCloseBtn").click();
                
                // Find and remove the feedback card if published
                if (data.isPublished) {
                    const feedbackCard = document.querySelector(`.feedback-card[data-id="${feedbackId}"]`);
                    if (feedbackCard) {
                        const cardContainer = feedbackCard.closest('.col-xl-4');
                        if (cardContainer) {
                            cardContainer.remove();
                            
                            // Check if there are no more feedback cards
                            const cardsContainer = document.querySelector('.feedback-cards-container .row');
                            if (cardsContainer && cardsContainer.children.length === 0) {
                                cardsContainer.innerHTML = `
                                    <div class="col-12">
                                        <div class="empty-state">
                                            <i class="fas fa-comment-alt"></i>
                                            <p>No feedback messages found</p>
                                        </div>
                                    </div>
                                `;
                            }
                        }
                    }
                }
                
                // Show success message after UI is updated
                Swal.fire({
                    icon: 'success',
                    title: modalTitle,
                    text: modalText,
                    timer: 1500,
                    showConfirmButton: false
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.message
                });
            }
        })
        .catch(error => {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'An error occurred while updating the status.'
            });
        });
    });
</script>


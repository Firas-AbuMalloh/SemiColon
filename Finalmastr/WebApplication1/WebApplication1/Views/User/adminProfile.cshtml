                                                                    <div class="d-flex justify-content-between">
                                                                        <div class="user-name font-weight-bold">@user.FirstName @user.LastName</div>
                                                                        <div class="user-date small text-muted">@(user.CreatedAt.HasValue ? user.CreatedAt.Value.ToString("yyyy-MM-dd") : "N/A")</div>
                                                                    </div>
                                                                    <div class="user-email small text-muted">@user.Email</div>
                                                                </div>
                                                                <div class="user-actions">
                                                                    <a href="#" class="btn btn-sm btn-outline-primary user-details-btn" data-user-id="@user.Id">
                                                                        <i class="fas fa-eye"></i>
                                                                    </a>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="text-center mt-3">
                                                        <a asp-action="adminProfile" asp-controller="User" asp-route-viewName="Users" class="btn btn-sm btn-primary">
                                                            View All Users <i class="fas fa-arrow-right ml-1"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Low Stock Products -->
                                        <div class="col-lg-6 mb-4">
                                            <div class="card shadow mb-4">
                                                <div class="card-header py-3">
                                                    <h6 class="m-0 font-weight-bold text-primary">Low Stock Products</h6>
                                                </div>
                                                <div class="card-body">
                                                    <div class="table-responsive">
                                                        <table class="table table-bordered" width="100%" cellspacing="0">
                                                            <thead>
                                                                <tr>
                                                                    <th>Product ID</th>
                                                                    <th>Name</th>
                                                                    <th>Stock</th>
                                                                    <th>Actions</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var product in allProducts.Where(p => p.StockQuantity > 0 && p.StockQuantity <= 5).Take(5))
                                                                {
                                                                    <tr>
                                                                        <td>@product.Id</td>
                                                                        <td>@product.CardName</td>
                                                                        <td>
                                                                            <span class="@(product.StockQuantity <= 3 ? "text-danger" : "text-warning")">
                                                                                @product.StockQuantity
                                                                            </span>
                                                                        </td>
                                                                        <td>
                                                                            <a asp-action="EditCard" asp-controller="Cards" asp-route-id="@product.Id" class="btn btn-sm btn-primary">
                                                                                <i class="fas fa-edit"></i>
                                                                            </a>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="nav-orders" role="tabpanel">
                                <div class="axil-dashboard-order">
                                    <h4 class="mb-4">My Orders <small class="text-muted fs-6">(Your personal purchases)</small></h4>
                                    
                                    <!-- Orders Filter and Search -->
                                    <div class="mb-4 d-flex justify-content-between align-items-center">
                                        <div class="form-group mb-0 d-flex gap-2">
                                            <select id="orderStatusFilter" class="form-select">
                                                <option value="">All Statuses</option>
                                                <option value="Pending">Pending</option>
                                                <option value="Processing">Processing</option>
                                                <option value="Shipped">Shipped</option>
                                                <option value="Delivered">Delivered</option>
                                                <option value="Completed">Completed</option>
                                                <option value="Cancelled">Cancelled</option>
                                            </select>
                                        </div>
                                        <div class="d-flex">
                                            <input type="text" id="orderSearchInput" class="form-control" placeholder="Search orders...">
                                        </div>
                                    </div>
                                    
                                    <!-- Order Statistics -->
                                    <div class="mb-4 card bg-light">
                                        <div class="card-body p-3">
                                            <div class="row g-3">
                                                @{
                                                    var adminOrders = Model._orders.Where(o => o.UserId == Model._user.Id).ToList();
                                                    var adminOrderCount = adminOrders.Count();
                                                    var adminTotalSpent = adminOrders.Sum(o => o.TotalAmount);
                                                    var adminCompletedOrders = adminOrders.Count(o => o.Status != null && (o.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase) || o.Status.Equals("Delivered", StringComparison.OrdinalIgnoreCase)));
                                                    var adminAvgOrderValue = adminOrderCount > 0 ? adminTotalSpent / adminOrderCount : 0;
                                                }
                                                <div class="col-md-3 text-center">
                                                    <div class="stat-card p-2 rounded bg-white shadow-sm">
                                                        <h5 class="fs-6 mb-1 text-primary">Total Orders</h5>
                                                        <span class="fs-4 fw-bold">@adminOrderCount</span>
                                                    </div>
                                                </div>
                                                <div class="col-md-3 text-center">
                                                    <div class="stat-card p-2 rounded bg-white shadow-sm">
                                                        <h5 class="fs-6 mb-1 text-success">Total Spent</h5>
                                                        <span class="fs-4 fw-bold">$@adminTotalSpent.ToString("N2")</span>
                                                    </div>
                                                </div>
                                                <div class="col-md-3 text-center">
                                                    <div class="stat-card p-2 rounded bg-white shadow-sm">
                                                        <h5 class="fs-6 mb-1 text-info">Avg. Order</h5>
                                                        <span class="fs-4 fw-bold">$@adminAvgOrderValue.ToString("N2")</span>
                                                    </div>
                                                </div>
                                                <div class="col-md-3 text-center">
                                                    <div class="stat-card p-2 rounded bg-white shadow-sm">
                                                        <h5 class="fs-6 mb-1 text-warning">Completed</h5>
                                                        <span class="fs-4 fw-bold">@adminCompletedOrders</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    @if (adminOrders.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-hover orders-table">
                                                <thead class="bg-light">
                                                    <tr>
                                                        <th scope="col">Order ID</th>
                                                        <th scope="col">Date</th>
                                                        <th scope="col">Status</th>
                                                        <th scope="col">Items</th>
                                                        <th scope="col">Total</th>
                                                        <th scope="col">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="ordersTableBody">
                                                    @foreach (var order in adminOrders)
                                                    {
                                                        string badgeClass = order.Status switch
                                                        {
                                                            "Pending" => "bg-warning",
                                                            "Processing" => "bg-info",
                                                            "Shipped" => "bg-primary",
                                                            "Delivered" => "bg-success",
                                                            "Completed" => "bg-success",
                                                            "Cancelled" => "bg-danger",
                                                            _ => "bg-secondary"
                                                        };
                                                        
                                                        <tr class="order-row" data-status="@order.Status" data-order-id="@order.Id">
                                                            <td class="fw-bold">
                                                                <span class="order-icon"><i class="fas fa-shopping-basket"></i></span>
                                                                #@order.Id
                                                            </td>
                                                            <td>
                                                                <div>@order.CreatedAt?.ToString("MMM dd, yyyy")</div>
                                                                <small class="text-muted">@order.CreatedAt?.ToString("hh:mm tt")</small>
                                                            </td>
                                                            <td>
                                                                <span class="badge @badgeClass">@(order.Status ?? "N/A")</span>
                                                            </td>
                                                            <td>@(order.OrderDetails?.Count() ?? 0) items</td>
                                                            <td class="fw-bold">$@order.TotalAmount.ToString("N2")</td>
                                                            <td>
                                                                <div class="btn-group btn-group-sm" role="group">
                                                                    <button class="axil-btn btn-sm view-btn showOrderDetails" data-order-id="@order.Id">
                                                                        View Details
                                                                    </button>
                                                                    
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-5">
                                            <div class="empty-orders mb-3">
                                                <i class="fas fa-shopping-cart fa-3x text-muted"></i>
                                            </div>
                                            <h5>No Orders Found</h5>
                                            <p class="text-muted">You haven't placed any orders yet.</p>
                                        </div>
                                    }
                                </div>
                            </div>
                            
                            <!-- Order Details Modal -->
                            <div id="orderDetailsModal" class="modal fade" tabindex="-1" role="dialog">
                                <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header bg-light d-flex justify-content-between align-items-center py-2 px-3 border-0">
                                            <div>
                                                <h5 class="modal-title fw-bold">Order #<span id="modalOrderId"></span></h5>
                                                <small id="modalOrderDate" class="text-muted"></small>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <button type="button" class="btn btn-sm btn-outline-primary me-2" id="downloadInvoiceBtn">
                                                    <i class="fas fa-file-pdf me-1"></i> Download Invoice
                                                </button>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                        </div>
                                        <div class="modal-body">
                                            <!-- Invoice Section - This will be used for both display and printing/download -->
                                            <div id="invoiceContent" class="invoice-container">
                                                <!-- Invoice Header -->
                                                <div class="invoice-header mb-4">
                                                    <div class="row align-items-center">
                                                        <div class="col-md-6">
                                                            <div class="logo mb-3 text-center text-md-start">
                                                                <img src="/assets/images/logo/image_red_neon.png" style="max-width:65%" alt="Sem;Colon" height="55">
                                                            </div>
                                                            <div class="company-info text-center text-md-start">
                                                                <h5 class="mb-1">Sem;Colon</h5>
                                                                <p class="mb-0 text-muted small">Your premier source for cards</p>
                                                                <p class="mb-0 text-muted small">info@semicolon.com | +962 799 258 206</p>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 text-center text-md-end mt-3 mt-md-0">
                                                            <div class="invoice-details">
                                                                <div class="invoice-id-container">
                                                                    <h3 class="invoice-title mb-2">INVOICE</h3>
                                                                    <div class="invoice-number mb-1">#<span id="invoiceOrderId"></span></div>
                                                                </div>
                                                                <div class="invoice-date mb-1"><i class="far fa-calendar-alt me-1"></i> <span id="invoiceOrderDate"></span></div>
                                                                <div class="invoice-status mb-2">
                                                                    <span class="badge" id="invoiceOrderStatus"></span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="invoice-separator mt-3"></div>
                                                </div>
                                                
                                                <!-- Customer Information -->
                                                <div class="row mb-4">
                                                    <div class="col-md-12 mb-3 mb-md-0">
                                                        <div class="info-card">
                                                            <div class="info-card-header">
                                                                <i class="fas fa-user me-2"></i> Customer Information
                                                            </div>
                                                            <div class="info-card-body py-2">
                                                                <div class="row">
                                                                    <div class="col-md-4 mb-2">
                                                                        <strong class="text-muted">Full Name:</strong>
                                                                        <div class="customer-name" id="customerName"></div>
                                                                    </div>
                                                                    <div class="col-md-4 mb-2">
                                                                        <strong class="text-muted">Email:</strong>
                                                                        <div class="customer-email" id="customerEmail"></div>
                                                                    </div>
                                                                    <div class="col-md-4 mb-2">
                                                                        <strong class="text-muted">Phone:</strong>
                                                                        <div class="customer-phone" id="customerPhone"></div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <!-- Order Items -->
                                                <div class="invoice-items mb-4">
                                                    <div class="invoice-section-title">
                                                        <i class="fas fa-shopping-cart me-2"></i> Order Items
                                                    </div>
                                                    <div class="table-responsive">
                                                        <table class="table invoice-items-table table-sm">
                                                            <thead>
                                                                <tr>
                                                                    <th scope="col" width="45%">Product</th>
                                                                    <th scope="col" class="text-end">Price</th>
                                                                    <th scope="col" class="text-center">Quantity</th>
                                                                    <th scope="col" class="text-end">Total</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="invoiceItemsTable">
                                                                <!-- Will be filled by JS -->
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                                
                                                <!-- Invoice Summary -->
                                                <div class="row">
                                                    <div class="col-md-7">
                                                        <div class="payment-info">
                                                            <div class="invoice-section-title mb-2">
                                                                <i class="fas fa-credit-card me-2"></i> Payment Information
                                                            </div>
                                                            <p class="mb-1"><strong class="text-muted">Payment Method:</strong> <span id="paymentMethod">Credit Card</span></p>
                                                            <p class="mb-1"><strong class="text-muted">Payment Status:</strong> <span class="badge bg-success">Paid</span></p>
                                                            <p class="mb-0 payment-note"><small>For any payment inquiries, please contact our customer support.</small></p>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <div class="invoice-totals">
                                                            <div class="invoice-section-title mb-2">
                                                                <i class="fas fa-money-bill-wave me-2"></i> Order Summary
                                                            </div>
                                                            <div class="totals-table">
                                                                <div class="totals-row">
                                                                    <div class="totals-label">Subtotal</div>
                                                                    <div class="totals-value" id="invoiceSubtotal">$0.00</div>
                                                                </div>
                                                                <div class="totals-row" id="discountRow">
                                                                    <div class="totals-label">Discount</div>
                                                                    <div class="totals-value discount-value" id="invoiceDiscount">$0.00</div>
                                                                </div>
                                                                <div class="totals-row totals-final">
                                                                    <div class="totals-label">Total Amount</div>
                                                                    <div class="totals-value" id="invoiceTotalAmount">$0.00</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <!-- Thank You Note -->
                                                <div class="thank-you-note mt-4 pt-3">
                                                    <div class="text-center">
                                                        <h6 class="mb-1">Thank You for Your Purchase!</h6>
                                                        <p class="small text-muted mb-2">If you have any questions about your order, please contact our customer support team.</p>
                                                    </div>
                                                    <div class="barcode-container text-center mt-3">
                                                        <div class="barcode">
                                                            <div class="barcode-text">SC-<span id="barcode-order-id"></span></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <!-- Loading Indicator -->
                                            <div id="orderLoading" class="text-center py-5">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                                <p class="mt-2">Loading order details...</p>
                                            </div>
                                            
                                            <!-- Error Message -->
                                            <div id="orderError" class="alert alert-danger d-none">
                                                An error occurred while loading the order details. Please try again.
                                            </div>
                                        </div>
                                        
                                        <div class="modal-footer py-2 px-3 border-top bg-light">
                                            <div class="d-flex w-100 justify-content-between">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">
                                                    <i class="fas fa-times me-1"></i> Close
                                                </button>
                                                <button type="button" class="btn btn-sm btn-primary" id="downloadInvoiceBtn2">
                                                    <i class="fas fa-file-download me-1"></i> Download Invoice
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="nav-account" role="tabpanel">
                                <div class="col-lg-9">
                                    <div class="axil-dashboard-account">
                                        <form class="account-details-form" method="post" asp-action="updateProfile" asp-controller="User">
                                            @Html.AntiForgeryToken()
                                            <div class="row">
                                                <div class="col-lg-6">
                                                    <div class="form-group">
                                                        <label>First Name</label>
                                                        <input asp-for="_update.FirstName" class="form-control" value="@Model._user.FirstName" />
                                                        <span asp-validation-for="_update.FirstName" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-lg-6">
                                                    <div class="form-group">
                                                        <label>Last Name</label>
                                                        <input asp-for="_update.LastName" class="form-control" value="@Model._user.LastName" />
                                                        <span asp-validation-for="_update.LastName" class="text-danger"></span>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <h5 class="title">UserName</h5>
                                                    <div class="form-group">
                                                        <label>UserName</label>
                                                        <input asp-for="_update.Username" class="form-control" value="@Model._user.Username" />
                                                        <span asp-validation-for="_update.Username" class="text-danger"></span>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <h5 class="title">Phone Number</h5>
                                                    <div class="form-group">
                                                        <label>Phone Number</label>
                                                        <input asp-for="_update.PhoneNumber" class="form-control" value="@Model._user.PhoneNumber" />
                                                        <span asp-validation-for="_update.PhoneNumber" class="text-danger"></span>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <div class="toggle-bar">
                                                        <input asp-for="_update.ChangePassword" type="checkbox" id="changePasswordCheckbox" />
                                                        <label for="changePasswordCheckbox"><h5>Change Password</h5></label>
                                                    </div>

                                                    <div class="toggle-open collapsed" id="passwordChangeSection">
                                                        <br />
                                                        <div class="form-group">
                                                            <label>Current Password</label>
                                                            <input asp-for="_update.OldPassword" class="form-control" />
                                                            <span asp-validation-for="_update.OldPassword" class="text-danger"></span>
                                                        </div>
                                                        <div class="form-group">
                                                            <label>New Password</label>
                                                            <input asp-for="_update.NewPassword" class="form-control" />
                                                            <span asp-validation-for="_update.NewPassword" class="text-danger"></span>
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Confirm New Password</label>
                                                            <input asp-for="_update.ConfirmPassword" class="form-control" />
                                                            <span asp-validation-for="_update.ConfirmPassword" class="text-danger"></span>
                                                        </div>
                                                    </div>
                                                </div>


                                                <div class="col-12 mt-3">
                                                    <div class="form-group mb--0">
                                                        <input type="submit" class="axil-btn" value="Save Changes" />
                                                    </div>
                                                </div>
                                            </div>
                                        </form>


                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="nav-cards" role="tabpanel">
                                <div class="axil-dashboard-order">
                                    <div class="card-management">
                                        <div class="card-header">
                                            <h1 class="card-title">Card Management</h1>
                                            <button type="button" id="pmAddProductBtn" class="modern-add-btn">
                                                <span class="btn-icon"><i class="fas fa-plus-circle"></i></span>
                                                <span class="btn-text">Add New Card</span>
                                            </button>
                                        </div>

                                        <div class="card-stats-container">
                                            <div class="card-stat-box">
                                                <div class="stat-icon">
                                                    <i class="fas fa-credit-card"></i>
                                                </div>
                                                <div class="stat-content">
                                                    <h3 class="stat-value">@Model._allCards.Count()</h3>
                                                    <p class="stat-label">Total Cards</p>
                                                </div>
                                            </div>
                                            <div class="card-stat-box">
                                                <div class="stat-icon accent-green">
                                                    <i class="fas fa-check-circle"></i>
                                                </div>
                                                <div class="stat-content">
                                                    <h3 class="stat-value">@Model._allCards.Count(c => c.StockQuantity > 0)</h3>
                                                    <p class="stat-label">In Stock</p>
                                                </div>
                                            </div>
                                            <div class="card-stat-box">
                                                <div class="stat-icon accent-red">
                                                    <i class="fas fa-exclamation-circle"></i>
                                                </div>
                                                <div class="stat-content">
                                                    <h3 class="stat-value">@Model._allCards.Count(c => c.StockQuantity == 0)</h3>
                                                    <p class="stat-label">Out of Stock</p>
                                                </div>
                                            </div>
                                            <div class="card-stat-box">
                                                <div class="stat-icon accent-blue">
                                                    <i class="fas fa-dollar-sign"></i>
                                                </div>
                                                <div class="stat-content">
                                                    <h3 class="stat-value">@Model._allCards.Sum(c => c.Price).ToString("C2")</h3>
                                                    <p class="stat-label">Total Value</p>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="card-search-filter">
                                            <div class="modern-search-box">
                                                <div class="search-input-wrapper">
                                                    <i class="fas fa-search search-icon"></i>
                                                    <input type="text" id="pmSearchInput" class="modern-search-input" placeholder="Search cards by name, category...">
                                                    <button class="search-clear-btn" title="Clear search">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="modern-filter-box">
                                                <div class="filter-item">
                                                    <label for="cardCategoryFilter">Category:</label>
                                                    <div class="select-wrapper">
                                                        <select id="cardCategoryFilter" class="modern-select">
                                                            <option value="">All Categories</option>
                                                            @if (ViewBag.AllCategories != null)
                                                            {
                                                                foreach (var category in ViewBag.AllCategories)
                                                                {
                                                                    <option value="@category.Name">@category.Name</option>
                                                                }
                                                            }
                                                        </select>
                                                        <i class="fas fa-chevron-down"></i>
                                                    </div>
                                                </div>
                                                <div class="filter-item">
                                                    <label for="cardStockFilter">Stock:</label>
                                                    <div class="select-wrapper">
                                                        <select id="cardStockFilter" class="modern-select">
                                                            <option value="">All Stock Status</option>
                                                            <option value="instock">In Stock</option>
                                                            <option value="lowstock">Low Stock (≤ 5)</option>
                                                            <option value="outofstock">Out of Stock</option>
                                                        </select>
                                                        <i class="fas fa-chevron-down"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="cards-grid-container">
                                            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
                                                @foreach (var card in Model._allCards)
                                                {
                                                    string stockClass = card.StockQuantity > 5 ? "stock-badge-success" : 
                                                                       (card.StockQuantity > 0 ? "stock-badge-warning" : "stock-badge-danger");
                                                    
                                                    string stockText = card.StockQuantity > 5 ? "In Stock" : 
                                                                      (card.StockQuantity > 0 ? "Low Stock" : "Out of Stock");

                                                    <div class="col card-grid-item" data-category="@card.Category.CategoryName" data-stock="@stockText.ToLower().Replace(" ", "")">
                                                        <div class="product-card">
                                                            <div class="product-card-header">
                                                                <div class="product-image">
                                                                    <img src="~/assets/images/product/@card.ImageUrl" alt="@card.CardName" class="img-fluid">
                                                                </div>
                                                                <div class="product-badges">
                                                                    <span class="stock-badge @stockClass">

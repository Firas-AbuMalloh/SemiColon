<script>
    // Check if we need to show user details automatically
    $(document).ready(function() {
        // Set the active tab based on ViewBag.ActiveView
        @if (!string.IsNullOrEmpty(ViewBag.ActiveView))
        {
            <text>
            // Find the tab with the specified view name and activate it
            $('.sidebar-menu a[data-target="@ViewBag.ActiveView"]').tab('show');
            </text>
        }
    
        @if (ViewBag.ShowUserDetails == true)
        {
            <text>
            // Show user details in modal
            Swal.fire({
                title: 'User Details',
                html: `
                    <div class="user-details-container">
                        <div class="text-center mb-3">
                            <img src="/assets/images/profile/@ViewBag.UserDetailsProfileImageUrl" alt="@ViewBag.UserDetailsUsername" 
                                 class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover;">
                        </div>
                        <h4 class="mb-1">@ViewBag.UserDetailsName</h4>
                        <p class="text-muted mb-1">@@@ViewBag.UserDetailsUsername</p>
                        <div class="mb-2">
                            <span class="badge bg-primary">@ViewBag.UserDetailsRole</span>
                            @if (ViewBag.UserDetailsIsVerified == true)
                            {
                                <span class="badge bg-success"><i class="fas fa-check-circle"></i> Verified</span>
                            }
                            else
                            {
                                <span class="badge bg-danger"><i class="fas fa-times-circle"></i> Not Verified</span>
                            }
                        </div>
                        <div class="user-details-info mt-3">
                            <p><strong>Email:</strong> @ViewBag.UserDetailsEmail</p>
                            <p><strong>User ID:</strong> @ViewBag.UserDetailsId</p>
                        </div>
                    </div>
                `,
                customClass: {
                    container: 'user-details-modal-container',
                    popup: 'user-details-modal-popup',
                    content: 'user-details-modal-content'
                },
                showCloseButton: true,
                showConfirmButton: false,
                showCancelButton: true,
                cancelButtonText: 'Close',
                width: '400px'
            });
            </text>
        }
    });
</script>
                            document.getElementById("blogTitle").value = data.title;
                            document.getElementById("blogContent").value = data.content;
                            
                            // Show the modal
            blogModal.style.display = "block";
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Failed to load blog details.'

    <!-- Dashboard Scripts -->
    <script>
        $(document).ready(function() {
            // Initialize any tables that need DataTable functionality
            initializeTables();
            
            // Initialize Chart.js if available
            initializeCharts();
            
            // Order details click handler
            $(document).on('click', '.order-link', function(e) {
                e.preventDefault();
                var orderId = $(this).data('order-id');
                openOrderDetailsModal(orderId);
            });
            
            // Order status update
            $('#updateOrderStatusBtn').on('click', function() {
                var orderId = $('#orderDetailsModal').data('order-id');
                var newStatus = $('#orderStatusSelect').val();
                updateOrderStatus(orderId, newStatus);
            });
            
            // Chart view options
            $('.chart-view-option').on('click', function(e) {
                e.preventDefault();
                var view = $(this).data('view');
                toggleChartView(view);
            });
            
            // Refresh status data
            $('#refreshStatusData').on('click', function(e) {
                e.preventDefault();
                refreshStatusData();
            });
            
            // Initially hide the bars view 
            $('#statusBarsView').hide();
            
            // Card hover effects
            $('.card').hover(
                function() {
                    $(this).find('.fa-2x').addClass('text-primary');
                },
                function() {
                    $(this).find('.fa-2x').removeClass('text-primary');
                }
            );
            
            // Add custom class to tables
            $('.table').addClass('table-hover');
        });
        
        // Initialize DataTables
        function initializeTables() {
            if ($.fn.DataTable) {
                $('.table').each(function() {
                    if (!$.fn.DataTable.isDataTable(this)) {
                        $(this).DataTable({
                            "pageLength": 5,
                            "lengthChange": false,
                            "info": false,
                            "searching": true,
                            "language": {
                                "search": "<i class='fas fa-search'></i>",
                                "searchPlaceholder": "Search...",
                                "emptyTable": "<div class='text-center p-3'><i class='fas fa-info-circle text-info mb-2' style='font-size: 2rem;'></i><br>No data available</div>"
                            },
                            "dom": "<'row'<'col-sm-12 col-md-6'f><'col-sm-12 col-md-6'l>>" +
                                   "<'row'<'col-sm-12'tr>>" +
                                   "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
                        });
                    }
                });
            }
        }
        
        // Initialize Chart.js if available
        function initializeCharts() {
            if (window.Chart) {
                // Orders by status chart
                var statusCtx = document.getElementById('orderStatusChart');
                if (statusCtx) {
                    new Chart(statusCtx, {
                        type: 'doughnut',
                        data: {
                            labels: ['Pending', 'Processing', 'Shipped', 'Delivered/Completed', 'Cancelled'],
                            datasets: [{
                                data: [@pendingOrdersCount, @processingOrdersCount, @shippedOrdersCount, @deliveredOrdersCount, @cancelledOrdersCount],
                                backgroundColor: ['#f6c23e', '#36b9cc', '#4e73df', '#1cc88a', '#e74a3b'],
                                borderWidth: 1,
                                borderColor: '#ffffff'
                            }]
                        },
                        options: {
                            maintainAspectRatio: false,
                            responsive: true,
                            cutoutPercentage: 70,
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 12,
                                    padding: 15,
                                    fontFamily: "'Nunito', 'Segoe UI', sans-serif"
                                }
                            },
                            animation: {
                                animateScale: true,
                                animateRotate: true
                            },
                            tooltips: {
                                titleFontFamily: "'Nunito', 'Segoe UI', sans-serif",
                                bodyFontFamily: "'Nunito', 'Segoe UI', sans-serif",
                                titleFontSize: 14,
                                bodyFontSize: 14,
                                caretPadding: 10,
                                displayColors: false
                            }
                        }
                    });
                }
            }
        }
        
        // Open order details modal and fetch data
        function openOrderDetailsModal(orderId) {
            // Reset and show modal
            resetOrderModal();
            $("#modalOrderId").text(orderId);
            $("#invoiceOrderId").text(orderId);
            $("#barcode-order-id").text(orderId);
            $("#orderDetailsModal").modal("show");
            
            // Show loading indicator
            $("#orderLoading").show();
            $("#invoiceContent").hide();
            $("#orderError").addClass("d-none");
            
            // Fetch order details
            $.ajax({
                url: '/User/GetOrderDetails',
                type: 'GET',
                data: { orderId: orderId },
                success: function(data) {
                    handleOrderDetailsSuccess(data, orderId);
                },
                error: function() {
                    handleOrderDetailsError();
                }
            });
            
            // Additional request to get order metadata
            $.ajax({
                url: '/User/GetOrderMetadata',
                type: 'GET',
                data: { orderId: orderId },
                success: function(metadata) {
                    populateOrderMetadata(metadata);
                },
                error: function() {
                    // Silently handle this error, the UI can still function without metadata
                    console.log("Failed to load order metadata");
                }
            });
        }
        
        // Update order status
        function updateOrderStatus(orderId, newStatus) {
            // Show loading state on button
            var $btn = $('#updateOrderStatusBtn');
            var originalBtnHtml = $btn.html();
            $btn.html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Updating...');
            $btn.prop('disabled', true);
            
            $.ajax({
                url: '@Url.Action("UpdateOrderStatus", "User")',
                type: 'POST',
                data: { 
                    orderId: orderId, 
                    status: newStatus 
                },
                success: function(result) {
                    // Restore button
                    $btn.html(originalBtnHtml);
                    $btn.prop('disabled', false);
                    
                    if (result.success) {
                        // Show success notification
                        showNotification('Success!', 'Order status updated successfully.', 'success');
                        
                        // Update the status badge in the table if it exists
                        var badgeClass = getBadgeClassForStatus(newStatus);
                        $('.table tr').find('a[data-order-id="' + orderId + '"]').closest('tr').find('.badge')
                            .removeClass('badge-secondary badge-warning badge-info badge-primary badge-success badge-danger')
                            .addClass(badgeClass)
                            .text(newStatus);
                            
                        // If we're in the status tab, update the timeline
                        if ($('#order-status-tab').hasClass('active')) {
                            // Add a new timeline entry for the status change
                            var now = new Date();
                            var timeStr = now.toLocaleString();
                            var newTimelineItem = 
                                '<div class="timeline-item">' +
                                    '<div class="timeline-point"><i class="fas fa-check"></i></div>' +
                                    '<div class="timeline-content">' +
                                        '<span class="timeline-date">' + timeStr + '</span>' +
                                        '<h5 class="timeline-title">Status Updated to ' + newStatus + '</h5>' +
                                        '<p>Order status was updated by admin.</p>' +
                                    '</div>' +
                                '</div>';
                                
                            $('.order-timeline').prepend(newTimelineItem);
                        }
                    } else {
                        showNotification('Error!', result.message || 'Failed to update order status.', 'error');
                    }
                },
                error: function() {
                    // Restore button
                    $btn.html(originalBtnHtml);
                    $btn.prop('disabled', false);
                    showNotification('Error!', 'Failed to communicate with the server. Please try again.', 'error');
                }
            });
        }
        
        // Handle order details success response
        function handleOrderDetailsSuccess(data, orderId) {
            $("#orderLoading").hide();
            $("#invoiceContent").show();
            
            // If we have order items
            if (data && data.length > 0) {
                // Clear and populate table
                var tbody = $('#invoiceItemsTable');
                tbody.empty();
                
                var subtotal = 0;
                var discountValue = 0;
                
                // Get discount from the first item (they all have the same order reference)
                if (data[0] && data[0].order) {
                    // Use discountValue field directly from order
                    if (data[0].order.discountValue !== null && data[0].order.discountValue !== undefined) {
                        discountValue = parseFloat(data[0].order.discountValue);
                    }
                    
                    // Use provided subtotal if available, otherwise calculate
                    if (data[0].order.subtotal !== null && data[0].order.subtotal !== undefined) {
                        subtotal = parseFloat(data[0].order.subtotal);
                    }
                }
                
                // If no subtotal provided, calculate from items
                if (subtotal === 0) {
                    // Add order items and calculate subtotal
                    data.forEach(function(detail, index) {
                        var itemTotal = detail.price * detail.quantity;
                        subtotal += itemTotal;
                        
                        var row = `
                            <tr class="invoice-item">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="product-img me-2">
                                            <img src="/assets/images/product/${detail.imageUrl || 'default.jpg'}" alt="${detail.cardName}" class="img-fluid" style="width: 35px; height: 35px; object-fit: contain;">
                                        </div>
                                        <div>
                                            <div class="fw-medium">${detail.cardName}</div>
                                            <small class="text-muted" style="font-size: 11px;">${detail.sku || 'SKU: N/A'}</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end">$${detail.price.toFixed(2)}</td>
                                <td class="text-center">${detail.quantity}</td>
                                <td class="text-end">$${itemTotal.toFixed(2)}</td>
                            </tr>
                        `;
                        tbody.append(row);
                    });
                } else {
                    // Subtotal is provided, still add all items to the table
                    data.forEach(function(detail, index) {
                        var itemTotal = detail.price * detail.quantity;
                        
                        var row = `
                            <tr class="invoice-item">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="product-img me-2">
                                            <img src="/assets/images/product/${detail.imageUrl || 'default.jpg'}" alt="${detail.cardName}" class="img-fluid" style="width: 35px; height: 35px; object-fit: contain;">
                                        </div>
                                        <div>
                                            <div class="fw-medium">${detail.cardName}</div>
                                            <small class="text-muted" style="font-size: 11px;">${detail.sku || 'SKU: N/A'}</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end">$${detail.price.toFixed(2)}</td>
                                <td class="text-center">${detail.quantity}</td>
                                <td class="text-end">$${itemTotal.toFixed(2)}</td>
                            </tr>
                        `;
                        tbody.append(row);
                    });
                }
                
                // Calculate total amount (subtotal - discount)
                var totalAmount = data[0].order.totalAmount || (subtotal - discountValue);
                
                // Update financial summary
                $("#invoiceSubtotal").text("$" + subtotal.toFixed(2));
                
                // Always show discount row for clarity
                if (discountValue > 0) {
                    $("#invoiceDiscount").text("-$" + discountValue.toFixed(2)).addClass("text-success");
                    $("#discountRow").show().addClass("highlight-discount");
                } else {
                    $("#invoiceDiscount").text("$0.00");
                    $("#discountRow").show();
                }
                
                $("#invoiceTotalAmount").text("$" + totalAmount.toFixed(2));
            } else {
                // Show empty message
                $('#invoiceItemsTable').html(`
                    <tr>
                        <td colspan="4" class="text-center py-4">
                            <div class="text-muted">
                                <i class="fas fa-box-open mb-2" style="font-size: 2rem;"></i>
                                <p>No items found in this order.</p>
                            </div>
                        </td>
                    </tr>
                `);
                
                // Reset financial summary
                $("#invoiceSubtotal").text("$0.00");
                $("#invoiceDiscount").text("$0.00");
                $("#invoiceTotalAmount").text("$0.00");
                $("#discountRow").show();
            }
            
            // Setup download invoice button
            $("#downloadInvoiceBtn, #downloadInvoiceBtn2").off("click").on("click", function() {
                generatePDF();
            });
        }
        
        function handleOrderDetailsError() {
            $("#orderLoading").hide();
            $("#orderError").removeClass("d-none");
            $("#invoiceContent").hide();
        }
        
        function populateOrderMetadata(metadata) {
            if (!metadata) return;
            
            // Order date
            if (metadata.orderDate) {
                var formattedDate = new Date(metadata.orderDate).toLocaleDateString('en-US', { 
                    year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' 
                });
                $("#modalOrderDate").text(formattedDate);
                $("#invoiceOrderDate").text(formattedDate);
            }
            
            // Order status
            if (metadata.status) {
                var statusClass = '';
                switch(metadata.status) {
                    case "Pending": statusClass = "bg-warning"; break;
                    case "Processing": statusClass = "bg-info"; break;
                    case "Shipped": statusClass = "bg-primary"; break;
                    case "Delivered": statusClass = "bg-success"; break;
                    case "Completed": statusClass = "bg-success"; break;
                    case "Cancelled": statusClass = "bg-danger"; break;
                    default: statusClass = "bg-secondary";
                }
                $("#invoiceOrderStatus").addClass(statusClass).text(metadata.status);
            }
            
            // Payment information
            if (metadata.paymentMethod) {
                $("#paymentMethod").text(metadata.paymentMethod);
            }
            
            // Financial summary - update from metadata if available
            if (metadata.subtotal !== undefined) {
                $("#invoiceSubtotal").text("$" + parseFloat(metadata.subtotal).toFixed(2));
            }
            
            if (metadata.discountValue !== undefined && metadata.discountValue > 0) {
                $("#invoiceDiscount").text("-$" + parseFloat(metadata.discountValue).toFixed(2)).addClass("text-success");
                $("#discountRow").show().addClass("highlight-discount");
            } else if (metadata.discountValue !== undefined) {
                $("#invoiceDiscount").text("$0.00");
                $("#discountRow").show();
            }
            
            if (metadata.totalAmount !== undefined) {
                $("#invoiceTotalAmount").text("$" + parseFloat(metadata.totalAmount).toFixed(2));
            }
            
            // Customer information
            if (metadata.customer) {
                $("#customerName").text(metadata.customer.name || "N/A");
                $("#customerEmail").text(metadata.customer.email || "Email not available");
                $("#customerPhone").text(metadata.customer.phone || "Phone not available");
            }
            
            // Shipping address
            if (metadata.shippingAddress) {
                $("#invoiceShippingAddress").html(`
                    <p class="mb-1">${metadata.shippingAddress.name || 'N/A'}</p>
                    <p class="mb-1">${metadata.shippingAddress.street || 'N/A'}</p>
                    <p class="mb-0">${metadata.shippingAddress.city || 'N/A'}, ${metadata.shippingAddress.state || 'N/A'} ${metadata.shippingAddress.zip || 'N/A'}</p>
                `);
            } else {
                // Fallback if no address
                $("#invoiceShippingAddress").html(`<p class="mb-0">(Address not available)</p>`);
            }
        }
        
        function resetOrderModal() {
            $("#invoiceItemsTable").empty();
            $("#modalOrderId").text("");
            $("#invoiceOrderId").text("");
            $("#modalOrderDate").text("");
            $("#invoiceOrderDate").text("");
            $("#customerName").text("");
            $("#customerEmail").text("");
            $("#customerPhone").text("");
            $("#invoiceOrderStatus").removeClass("bg-info bg-primary bg-success bg-danger bg-secondary").text("");
            $("#invoiceSubtotal").text("$0.00");
            $("#invoiceDiscount").text("$0.00");
            $("#invoiceTotalAmount").text("$0.00");
            $("#invoiceShippingAddress").html("");
            $("#paymentMethod").text("Credit Card");
            $("#paymentStatus").text("Paid");
            $("#barcode-order-id").text("");
            $("#discountRow").hide();
        }
        
        // Get icon for status
        function getIconForStatus(status) {
            switch((status || '').toLowerCase()) {
                case 'pending': return 'fas fa-clock';
                case 'processing': return 'fas fa-cogs';
                case 'shipped': return 'fas fa-shipping-fast';
                case 'completed':
                case 'delivered': return 'fas fa-check-circle';
                case 'cancelled': return 'fas fa-times-circle';
                default: return 'fas fa-question-circle';
            }
        }
        
        // Get badge class for status
        function getBadgeClassForStatus(status) {
            switch((status || '').toLowerCase()) {
                case 'pending': return 'badge-warning';
                case 'processing': return 'badge-info';
                case 'shipped': return 'badge-primary';
                case 'completed':
                case 'delivered': return 'badge-success';
                case 'cancelled': return 'badge-danger';
                default: return 'badge-secondary';
            }
        }
        
        // Toggle chart view between chart and bars
        function toggleChartView(view) {
            if (view === 'chart') {
                $('#statusChartView').show();
                $('#statusBarsView').hide();
                $('.chart-view-option[data-view="chart"]').addClass('active');
                $('.chart-view-option[data-view="bars"]').removeClass('active');
            } else {
                $('#statusChartView').hide();
                $('#statusBarsView').show();
                $('.chart-view-option[data-view="bars"]').addClass('active');
                $('.chart-view-option[data-view="chart"]').removeClass('active');
            }
        }
        
        // Refresh status data
        function refreshStatusData() {
            // Show loading spinner
            var originalContent = $('#statusChartView').html();
            $('#statusChartView').html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><div class="mt-2">Refreshing data...</div></div>');
            
            // Simulate data refresh (in production, this would be an AJAX call)
            setTimeout(function() {
                $('#statusChartView').html(originalContent);
                
                // Re-initialize chart
                if (window.Chart) {
                    initializeCharts();
                }
                
                // Show success notification
                showNotification('Success', 'Data refreshed successfully', 'success');
            }, 1000);
        }
        
        // Show notification
        function showNotification(title, message, type) {
            if (window.toastr) {
                toastr[type](message, title);
            } else {
                alert(title + ': ' + message);
            }
        }
        
        function generatePDF() {
            // Show loading state
            var $downloadBtn = $("#downloadInvoiceBtn");
            var originalText = $downloadBtn.html();
            $downloadBtn.prop("disabled", true).html('<i class="fas fa-spinner fa-spin"></i> Generating...');
            
            // Clone the invoice content for printing
            var invoiceContent = $("#invoiceContent").clone();
            
            // Get order data
            var orderId = $("#invoiceOrderId").text();
            var orderDate = $("#invoiceOrderDate").text();
            
            // Use html2pdf library to generate PDF
            // Since we've already included the script in the page, we can use it directly
            convertToPDF(invoiceContent, orderId, orderDate);
        }
        
        function convertToPDF(content, orderId, orderDate) {
            // Create a container for the PDF content
            var element = document.createElement('div');
            element.innerHTML = content.html();
            
            // Ensure all styles are applied
            element.className = "invoice-container";
            element.style.padding = "20px";
            element.style.backgroundColor = "#fff";
            element.style.maxWidth = "100%";
            
            // Ensure images have full URLs
            $(element).find('img').each(function() {
                var src = $(this).attr('src');
                if (src && src.startsWith('/')) {
                    $(this).attr('src', window.location.origin + src);
                }
            });
            
            // Set up PDF options
            var opt = {
                margin:       [0.3, 0.3, 0.3, 0.3],
                filename:     'invoice-order-' + orderId + '.pdf',
                image:        { type: 'jpeg', quality: 1.0 },
                html2canvas:  { 
                    scale: 2, 
                    useCORS: true,
                    letterRendering: true,
                    allowTaint: true
                },
                jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
            };
            
            // Add element to document temporarily
            document.body.appendChild(element);
            
            // Generate PDF
            html2pdf()
                .from(element)
                .set(opt)
                .save()
                .then(function() {
                    // Reset download button and remove temporary element
                    $("#downloadInvoiceBtn").prop("disabled", false).html(originalText);
                    document.body.removeChild(element);
                });
        }
    </script>
</main>


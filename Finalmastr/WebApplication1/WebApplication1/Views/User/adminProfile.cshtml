    color: #6c757d;
    margin-bottom: 0;
}

/* تنسيق مربعات التصفية */
.contact-filter-container {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 20px;
    align-items: flex-end;
}

.contact-filter-group {

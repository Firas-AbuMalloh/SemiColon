<script>
    document.addEventListener('DOMContentLoaded', function () {
        const checkbox = document.getElementById('changePasswordCheckbox');
        const section = document.getElementById('passwordChangeSection');

        // الحالة الابتدائية عند تحميل الصفحة
        checkbox.checked = false;
        section.classList.add('collapsed');

        // عند تغيير حالة الـ checkbox
        checkbox.addEventListener('change', function () {
            if (checkbox.checked) {
                section.classList.remove('collapsed'); // فتح
            } else {
                section.classList.add('collapsed');    // إغلاق
            }
        });
    });
</script>
@section Scripts {

    <script>
        $(document).ready(function () {
            // Order filtering and search
            $("#orderStatusFilter").on("change", function() {
                filterOrders();
            });
            
            $("#orderSearchInput").on("keyup", function() {
                filterOrders();
            });
            
            function filterOrders() {
                var status = $("#orderStatusFilter").val().toLowerCase();
                var searchText = $("#orderSearchInput").val().toLowerCase();
                
                $(".order-row").each(function() {
                    var rowStatus = $(this).data("status").toLowerCase();
                    var orderId = $(this).data("order-id").toString();
                    var rowText = $(this).text().toLowerCase();
                    
                    var statusMatch = status === "" || rowStatus === status;
                    var searchMatch = searchText === "" || 
                                     rowText.indexOf(searchText) > -1 || 
                                     orderId.indexOf(searchText) > -1;
                    
                    $(this).toggle(statusMatch && searchMatch);
                });
                
                // Show no results message if needed
                var visibleRows = $(".order-row:visible").length;
                if (visibleRows === 0) {
                    if ($("#noFilterResults").length === 0) {
                        $("#ordersTableBody").append(
                            '<tr id="noFilterResults"><td colspan="6" class="text-center py-4">' +
                            '<i class="fas fa-search me-2"></i> No orders matching your filters' +
                            '</td></tr>'
                        );
                    }
                } else {
                    $("#noFilterResults").remove();
                }
            }
            
            // Order details modal
            $(".showOrderDetails").click(function() {
                var orderId = $(this).data("order-id");
                loadOrderDetails(orderId);
            });
            
            function loadOrderDetails(orderId) {
                // Reset and show modal
                resetOrderModal();
                $("#modalOrderId").text(orderId);
                $("#invoiceOrderId").text(orderId);
                $("#barcode-order-id").text(orderId);
                $("#orderDetailsModal").modal("show");
                
                // Show loading indicator
                $("#orderLoading").show();
                $("#invoiceContent").hide();
                $("#orderError").addClass("d-none");
                
                // Fetch order details
                $.ajax({
                    url: '/User/GetOrderDetails',
                    type: 'GET',
                    data: { orderId: orderId },
                    success: function(data) {
                        handleOrderDetailsSuccess(data, orderId);
                    },
                    error: function() {
                        handleOrderDetailsError();
                    }
                });
                
                // Additional request to get order metadata
                $.ajax({
                    url: '/User/GetOrderMetadata',
                    type: 'GET',
                    data: { orderId: orderId },
                    success: function(metadata) {
                        populateOrderMetadata(metadata);
                    },
                    error: function() {
                        // Silently handle this error, the UI can still function without metadata
                        console.log("Failed to load order metadata");
                    }
                });
            }
            
            function handleOrderDetailsSuccess(data, orderId) {
                $("#orderLoading").hide();
                $("#invoiceContent").show();
                
                // If we have order items
                if (data && data.length > 0) {
                    // Clear and populate table
                    var tbody = $('#invoiceItemsTable');
                    tbody.empty();
                    
                    var subtotal = 0;
                    var discountValue = 0;
                    
                    // Get discount from the first item (they all have the same order reference)
                    if (data[0] && data[0].order) {
                        // Use discountValue field directly from order
                        if (data[0].order.discountValue !== null && data[0].order.discountValue !== undefined) {
                            discountValue = parseFloat(data[0].order.discountValue);
                        }
                        
                        // Use provided subtotal if available, otherwise calculate
                        if (data[0].order.subtotal !== null && data[0].order.subtotal !== undefined) {
                            subtotal = parseFloat(data[0].order.subtotal);
                        }
                    }
                    
                    // If no subtotal provided, calculate from items
                    if (subtotal === 0) {
                        // Add order items and calculate subtotal
                        data.forEach(function(detail, index) {
                            var itemTotal = detail.price * detail.quantity;
                            subtotal += itemTotal;
                            
                            var row = `
                                <tr class="invoice-item">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="product-img me-2">
                                                <img src="/assets/images/product/${detail.imageUrl || 'default.jpg'}" alt="${detail.cardName}" class="img-fluid" style="width: 35px; height: 35px; object-fit: contain;">
                                            </div>
                                            <div>
                                                <div class="fw-medium">${detail.cardName}</div>
                                                <small class="text-muted" style="font-size: 11px;">${detail.sku || 'SKU: N/A'}</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end">$${detail.price.toFixed(2)}</td>
                                    <td class="text-center">${detail.quantity}</td>
                                    <td class="text-end">$${itemTotal.toFixed(2)}</td>
                                </tr>
                            `;
                            tbody.append(row);
                        });
                    } else {
                        // Subtotal is provided, still add all items to the table
                        data.forEach(function(detail, index) {
                            var itemTotal = detail.price * detail.quantity;
                            
                            var row = `
                                <tr class="invoice-item">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="product-img me-2">
                                                <img src="/assets/images/product/${detail.imageUrl || 'default.jpg'}" alt="${detail.cardName}" class="img-fluid" style="width: 35px; height: 35px; object-fit: contain;">
                                            </div>
                                            <div>
                                                <div class="fw-medium">${detail.cardName}</div>
                                                <small class="text-muted" style="font-size: 11px;">${detail.sku || 'SKU: N/A'}</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end">$${detail.price.toFixed(2)}</td>
                                    <td class="text-center">${detail.quantity}</td>
                                    <td class="text-end">$${itemTotal.toFixed(2)}</td>
                                </tr>
                            `;
                            tbody.append(row);
                        });
                    }
                    
                    // Calculate total amount (subtotal - discount)
                    var totalAmount = data[0].order.totalAmount || (subtotal - discountValue);
                    
                    // Update financial summary
                    $("#invoiceSubtotal").text("$" + subtotal.toFixed(2));
                    
                    // Always show discount row for clarity
                    if (discountValue > 0) {
                        $("#invoiceDiscount").text("-$" + discountValue.toFixed(2)).addClass("text-success");
                        $("#discountRow").show().addClass("highlight-discount");
                    } else {
                        $("#invoiceDiscount").text("$0.00");
                        $("#discountRow").show();
                    }
                    
                    $("#invoiceTotalAmount").text("$" + totalAmount.toFixed(2));
                } else {
                    // Show empty message
                    $('#invoiceItemsTable').html(`
                        <tr>
                            <td colspan="4" class="text-center py-4">
                                <div class="text-muted">
                                    <i class="fas fa-box-open mb-2" style="font-size: 2rem;"></i>
                                    <p>No items found in this order.</p>
                                </div>
                            </td>
                        </tr>
                    `);
                    
                    // Reset financial summary
                    $("#invoiceSubtotal").text("$0.00");
                    $("#invoiceDiscount").text("$0.00");
                    $("#invoiceTotalAmount").text("$0.00");
                    $("#discountRow").show();
                }
                
                // Setup download invoice button
                $("#downloadInvoiceBtn, #downloadInvoiceBtn2").off("click").on("click", function() {
                    generatePDF();
                });
            }
            
            function handleOrderDetailsError() {
                $("#orderLoading").hide();
                $("#orderError").removeClass("d-none");
                $("#invoiceContent").hide();
            }
            
            function populateOrderMetadata(metadata) {
                if (!metadata) return;
                
                // Order date
                if (metadata.orderDate) {
                    var formattedDate = new Date(metadata.orderDate).toLocaleDateString('en-US', { 
                        year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' 
                    });
                    $("#modalOrderDate").text(formattedDate);
                    $("#invoiceOrderDate").text(formattedDate);
                }
                
                // Order status
                if (metadata.status) {
                    var statusClass = '';
                    switch(metadata.status) {
                        case "Processing": statusClass = "bg-info"; break;
                        case "Shipped": statusClass = "bg-primary"; break;
                        case "Delivered": statusClass = "bg-success"; break;
                        case "Completed": statusClass = "bg-success"; break;
                        case "Cancelled": statusClass = "bg-danger"; break;
                        default: statusClass = "bg-secondary";
                    }
                    $("#invoiceOrderStatus").addClass(statusClass).text(metadata.status);
                }
                
                // Payment information
                if (metadata.paymentMethod) {
                    $("#paymentMethod").text(metadata.paymentMethod);
                }
                
                // Financial summary - update from metadata if available
                if (metadata.subtotal !== undefined) {
                    $("#invoiceSubtotal").text("$" + parseFloat(metadata.subtotal).toFixed(2));
                }
                
                if (metadata.discountValue !== undefined && metadata.discountValue > 0) {
                    $("#invoiceDiscount").text("-$" + parseFloat(metadata.discountValue).toFixed(2)).addClass("text-success");
                    $("#discountRow").show().addClass("highlight-discount");
                } else if (metadata.discountValue !== undefined) {
                    $("#invoiceDiscount").text("$0.00");
                    $("#discountRow").show();
                }
                
                if (metadata.totalAmount !== undefined) {
                    $("#invoiceTotalAmount").text("$" + parseFloat(metadata.totalAmount).toFixed(2));
                }
                
                // Customer information
                if (metadata.customer) {
                    $("#customerName").text(metadata.customer.name || "N/A");
                    $("#customerEmail").text(metadata.customer.email || "Email not available");
                    $("#customerPhone").text(metadata.customer.phone || "Phone not available");
                }
                
                // Shipping address
                if (metadata.shippingAddress) {
                    $("#invoiceShippingAddress").html(`
                        <p class="mb-1">${metadata.shippingAddress.name || 'N/A'}</p>
                        <p class="mb-1">${metadata.shippingAddress.street || 'N/A'}</p>
                        <p class="mb-0">${metadata.shippingAddress.city || 'N/A'}, ${metadata.shippingAddress.state || 'N/A'} ${metadata.shippingAddress.zip || 'N/A'}</p>
                    `);
                } else {
                    // Fallback if no address
                    $("#invoiceShippingAddress").html(`<p class="mb-0">(Address not available)</p>`);
                }
            }
            
            function resetOrderModal() {
                $("#invoiceItemsTable").empty();
                $("#modalOrderId").text("");
                $("#invoiceOrderId").text("");
                $("#modalOrderDate").text("");
                $("#invoiceOrderDate").text("");
                $("#customerName").text("");
                $("#customerEmail").text("");
                $("#customerPhone").text("");
                $("#invoiceOrderStatus").removeClass("bg-info bg-primary bg-success bg-danger bg-secondary").text("");
                $("#invoiceSubtotal").text("$0.00");
                $("#invoiceDiscount").text("$0.00");
                $("#invoiceTotalAmount").text("$0.00");
                $("#invoiceShippingAddress").html("");
                $("#paymentMethod").text("Credit Card");
                $("#paymentStatus").text("Paid");
                $("#barcode-order-id").text("");
                $("#discountRow").hide();
            }
            
            function generatePDF() {
                // Show loading state
                var $downloadBtn = $("#downloadInvoiceBtn");
                var originalText = $downloadBtn.html();
                $downloadBtn.prop("disabled", true).html('<i class="fas fa-spinner fa-spin"></i> Generating...');
                
                // Clone the invoice content for printing
                var invoiceContent = $("#invoiceContent").clone();
                
                // Get order data
                var orderId = $("#invoiceOrderId").text();
                var orderDate = $("#invoiceOrderDate").text();
                
                // Use html2pdf library to generate PDF
                // If html2pdf is not already included, dynamically add it
                if (!window.html2pdf) {
                    var script = document.createElement('script');
                    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
                    script.onload = function() {
                        convertToPDF(invoiceContent, orderId, orderDate);
                    };
                    document.head.appendChild(script);
                } else {
                    convertToPDF(invoiceContent, orderId, orderDate);
                }
            }
            
            function convertToPDF(content, orderId, orderDate) {
                // Create a container for the PDF content
                var element = document.createElement('div');
                element.appendChild(content[0]);
                
                // Set up PDF options
                var opt = {
                    margin:       [0.5, 0.5, 0.5, 0.5],
                    filename:     'invoice-order-' + orderId + '.pdf',
                    image:        { type: 'jpeg', quality: 0.98 },
                    html2canvas:  { scale: 2, useCORS: true },
                    jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
                };
                
                // Generate PDF
                html2pdf().from(element).set(opt).save().then(function() {
                    // Reset download button
                    $("#downloadInvoiceBtn").prop("disabled", false).html(originalText);
                });
            }
        });
    </script>
    

    <script>
        $(document).ready(function () {
            // Add custom styling for download cards on hover
            $(".download-item").hover(
                function() { $(this).find(".download-overlay").css("display", "flex").fadeIn(200); },
                function() { $(this).find(".download-overlay").fadeOut(200); }
            );
            
            // Search functionality for downloads
            $("#downloadSearchInput").on("keyup", function() {
                var searchText = $(this).val().toLowerCase();
                $(".download-item").each(function() {
                    var cardName = $(this).find(".card-title").text().toLowerCase();
                    $(this).toggle(cardName.indexOf(searchText) > -1);
                });
            });
            
            // Handle download button click
            $(".download-btn").click(function() {
                var cardId = $(this).data("card-id");
                var imageUrl = $(this).data("image-url");
                var cardName = $(this).data("card-name");
                
                // Create a temporary anchor element for downloading
                downloadCardImage(imageUrl, cardName);
            });
            
            // Function to download the card image
            function downloadCardImage(imageUrl, cardName) {
                // Show loading indicator
                $('<div class="download-loading">Preparing download...</div>')
                    .css({
                        'position': 'fixed',
                        'top': '50%',
                        'left': '50%',
                        'transform': 'translate(-50%, -50%)',
                        'background': 'rgba(0,0,0,0.7)',
                        'color': 'white',
                        'padding': '15px 20px',
                        'border-radius': '5px',
                        'z-index': '9999'
                    })
                    .appendTo('body');
                
                // Create a canvas to process the image
                var canvas = document.createElement('canvas');
                var ctx = canvas.getContext('2d');
                var img = new Image();
                
                img.crossOrigin = "Anonymous"; // Handle cross-origin issues
                img.onload = function() {
                    // Set canvas size to image dimensions
                    canvas.width = img.width;
                    canvas.height = img.height;
                    
                    // Draw image to canvas
                    ctx.drawImage(img, 0, 0);
                    
                    try {
                        // Convert to data URL and trigger download
                        var dataURL = canvas.toDataURL("image/png");
                        
                        var link = document.createElement('a');
                        link.download = cardName.replace(/[^a-z0-9]/gi, '_').toLowerCase() + '.png';
                        link.href = dataURL;
                        link.click();
                        
                        // Remove loading indicator
                        $('.download-loading').remove();
                    } catch (e) {
                        console.error("Download failed:", e);
                        $('.download-loading').text("Download failed. Please try again.").delay(2000).fadeOut(400, function() {
                            $(this).remove();
                        });
                    }
                };
                
                img.onerror = function() {
                    console.error("Error loading image");
                    $('.download-loading').text("Error loading image. Please try again.").delay(2000).fadeOut(400, function() {
                        $(this).remove();
                    });
                };
                
                // Load the image from the server
                img.src = imageUrl;
            }
        });
    </script>
    

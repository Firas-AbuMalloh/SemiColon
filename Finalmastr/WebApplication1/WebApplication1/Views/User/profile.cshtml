@using SemiColon.Models
@{
    Layout = "~/Views/Shared/mainLayoutHeaderFooter.cshtml";
    ViewBag.Title = "Profile";
}

@model SemiColon.Models.ViewModel.profileViewModel

<main class="main-wrapper">
    <div class="axil-dashboard-area axil-section-gap">
        <div class="container">
            <div class="axil-dashboard-warp">
                <div class="axil-dashboard-author">
                    <div class="media" style="display:flex">
                        <div class="thumbnail">
                            <img src="~/assets/images/profile/@Model._user.ProfileImageUrl" alt="Hello UserProfileImage" style="width:20vh">
                        </div>
                        <div class="media-body" style="margin-left:4vh">
                            <h5 class="title mb-0">Hello @Model._user.Username</h5>
                            <span class="joining-date">Sem;Colon Member Since @Model._user.CreatedAt</span>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xl-3 col-md-4">
                        <aside class="axil-dashboard-aside">
                            <nav class="axil-dashboard-nav">
                                <div class="nav nav-tabs" role="tablist">
                                    <a class="nav-item nav-link active" data-bs-toggle="tab" href="#nav-dashboard" role="tab" aria-selected="true"><i class="fas fa-th-large"></i>Dashboard</a>
                                    <a class="nav-item nav-link" data-bs-toggle="tab" href="#nav-orders" role="tab" aria-selected="false"><i class="fas fa-shopping-basket"></i>Orders</a>
                                    <a class="nav-item nav-link" data-bs-toggle="tab" href="#nav-downloads" role="tab" aria-selected="false"><i class="fas fa-file-download"></i>Downloads</a>
                                    @* <a class="nav-item nav-link" data-bs-toggle="tab" href="#nav-address" role="tab" aria-selected="false"><i class="fas fa-home"></i>Addresses</a> *@
                                    <a class="nav-item nav-link" data-bs-toggle="tab" href="#nav-account" role="tab" aria-selected="false"><i class="fas fa-user"></i>Account Details</a>
                                    <a class="nav-item nav-link" style="color:red" asp-action="signOut" asp-controller="User"><i class="fal fa-sign-out"></i>Logout</a>
                                </div>
                            </nav>
                        </aside>
                    </div>
                    <div class="col-xl-9 col-md-8">
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="nav-dashboard" role="tabpanel">
                                <div class="axil-dashboard-overview">
                                    <div class="welcome-text">Hello @Model._user.FirstName <span class="text-muted fs-6">(not @Model._user.FirstName? <a asp-action="signOut" asp-controller="User">Log Out</a>)</span></div>
                                    <p>From your account dashboard you can view your recent orders, manage your shipping and billing addresses, and edit your password and account details.</p>
                                    
                                    <!-- User Statistics -->
                                    <div class="row mt-4">
                                        <!-- Total Orders -->
                                        <div class="col-md-3 mb-4">
                                            <div class="card border-0 shadow-sm h-100 bg-gradient" style="--bs-gradient: linear-gradient(to right, rgba(255, 73, 124, 0.1), rgba(255, 73, 124, 0.05));">
                                                <div class="card-body text-center">
                                                    <div class="stat-icon mb-3" style="color: #FF497C; font-size: 2.5rem;">
                                                        <i class="fas fa-shopping-bag"></i>
                                                    </div>
                                                    <h3 class="stat-value">@Model._orders.Count()</h3>
                                                    <p class="stat-label mb-0">Total Orders</p>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Total Amount Spent -->
                                        <div class="col-md-3 mb-4">
                                            <div class="card border-0 shadow-sm h-100 bg-gradient" style="--bs-gradient: linear-gradient(to right, rgba(92, 188, 107, 0.1), rgba(92, 188, 107, 0.05));">
                                                <div class="card-body text-center">
                                                    <div class="stat-icon mb-3" style="color: #5CBC6B; font-size: 2.5rem;">
                                                        <i class="fas fa-dollar-sign"></i>
                                                    </div>
                                                    <h3 class="stat-value">$@Model._orders.Sum(o => o.TotalAmount).ToString("0.00")</h3>
                                                    <p class="stat-label mb-0">Total Spent</p>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Favorite Items -->
                                        <div class="col-md-3 mb-4">
                                            <div class="card border-0 shadow-sm h-100 bg-gradient" style="--bs-gradient: linear-gradient(to right, rgba(255, 107, 107, 0.1), rgba(255, 107, 107, 0.05));">
                                                <div class="card-body text-center">
                                                    <div class="stat-icon mb-3" style="color: #FF6B6B; font-size: 2.5rem;">
                                                        <i class="fas fa-heart"></i>
                                                    </div>
                                                    @{
                                                        var favCount = Model._user.Favorites?.Count() ?? 0;
                                                    }
                                                    <h3 class="stat-value">@favCount</h3>
                                                    <p class="stat-label mb-0">Favorite Items</p>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Last Login -->
                                        <div class="col-md-3 mb-4">
                                            <div class="card border-0 shadow-sm h-100 bg-gradient" style="--bs-gradient: linear-gradient(to right, rgba(81, 145, 240, 0.1), rgba(81, 145, 240, 0.05));">
                                                <div class="card-body text-center">
                                                    <div class="stat-icon mb-3" style="color: #5191F0; font-size: 2.5rem;">
                                                        <i class="fas fa-clock"></i>
                                                    </div>
                                                    <h3 class="stat-value" style="font-size: 1rem;">@(Model._user.LastLogin?.ToString("dd MMM, yyyy") ?? "Not logged in yet")</h3>
                                                    <p class="stat-label mb-0">Last Login</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="row mt-3">
                                        <!-- Recent Orders -->
                                        <div class="col-lg-7">
                                            <div class="card border-0 shadow-sm">
                                                <div class="card-header bg-transparent border-bottom-0">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <h5 class="mb-0"><i class="fas fa-shopping-basket me-2 text-primary"></i> Recent Orders</h5>
                                                        @if(Model._orders.Any())
                                                        {
                                                            <a class="btn btn-sm btn-outline-primary" data-bs-toggle="tab" href="#nav-orders" role="tab">View All</a>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="card-body">
                                                    @if(Model._orders.Any())
                                                    {
                                                        <div class="table-responsive">
                                                            <table class="table table-hover">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Order ID</th>
                                                                        <th>Date</th>
                                                                        <th>Status</th>
                                                                        <th>Total</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach(var order in Model._orders.OrderByDescending(o => o.CreatedAt).Take(3))
                                                                    {
                                                                        <tr>
                                                                            <td><span class="fw-bold">#@order.Id</span></td>
                                                                            <td>@order.CreatedAt?.ToString("MMM dd, yyyy")</td>
                                                                            <td>
                                                                                @{
                                                                                    var statusClass = order.Status switch
                                                                                    {
                                                                                        "Processing" => "bg-info",
                                                                                        "Shipped" => "bg-primary",
                                                                                        "Delivered" => "bg-success",
                                                                                        "Completed" => "bg-success",
                                                                                        "Cancelled" => "bg-danger",
                                                                                        _ => "bg-secondary"
                                                                                    };
                                                                                }
                                                                                <span class="badge @statusClass">
                                                                                    @order.Status
                                                                                </span>
                                                                            </td>
                                                                            <td><span class="fw-bold">$@order.TotalAmount.ToString("0.00")</span></td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-center py-4">
                                                            <div class="empty-icon mb-3" style="color: #6c757d; font-size: 3rem;">
                                                                <i class="fas fa-shopping-cart"></i>
                                                            </div>
                                                            <p class="text-muted">You haven't placed any orders yet.</p>
                                                            <a asp-controller="Products" asp-action="shop" class="axil-btn">Start Shopping</a>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Favorite Items -->
                                        <div class="col-lg-5">
                                            <div class="card border-0 shadow-sm">
                                                <div class="card-header bg-transparent border-bottom-0">
                                                    <h5 class="mb-0"><i class="fas fa-heart me-2 text-danger"></i> Favorite Items</h5>
                                                </div>
                                                <div class="card-body">
                                                    @if(Model._user.Favorites != null && Model._user.Favorites.Any())
                                                    {
                                                        <div class="favorite-items-carousel">
                                                            @foreach(var fav in Model._user.Favorites.OrderByDescending(f => f.CreatedAt).Take(3))
                                                            {
                                                                <div class="favorite-item mb-3 d-flex align-items-center border-bottom pb-3">
                                                                    <div class="favorite-thumb me-3" style="width: 60px; height: 60px; overflow: hidden;">
                                                                        <img src="~/assets/images/product/@(fav.Card?.ImageUrl ?? "default-card.jpg")" 
                                                                            alt="@(fav.Card?.CardName ?? "Card")" 
                                                                            class="img-fluid" style="object-fit: cover; width: 100%; height: 100%;">
                                                                    </div>
                                                                    <div class="favorite-content flex-grow-1">
                                                                        <h6 class="mb-1">@(fav.Card?.CardName ?? "Unknown Card")</h6>
                                                                        <div class="d-flex justify-content-between align-items-center">
                                                                            <span class="text-primary fw-bold">$@(fav.Card?.Price.ToString("0.00") ?? "0.00")</span>
                                                                            <a asp-action="productDetails" asp-controller="Products" asp-route-id="@fav.CardId" class="btn btn-sm btn-outline-primary">View</a>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                            <div class="text-center mt-3">
                                                                <a href="/Products/favorites" class="btn btn-sm btn-outline-danger">View All Favorites</a>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-center py-4">
                                                            <div class="empty-icon mb-3" style="color: #6c757d; font-size: 3rem;">
                                                                <i class="fas fa-heart-broken"></i>
                                                            </div>
                                                            <p class="text-muted">No items in favorites.</p>
                                                            <a asp-controller="Products" asp-action="shop" class="axil-btn">Browse Products</a>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Account Information Card -->
                                    <div class="card border-0 shadow-sm mt-4">
                                        <div class="card-header bg-transparent border-bottom-0">
                                            <h5 class="mb-0"><i class="fas fa-user-shield me-2 text-secondary"></i> Account Information</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <div class="d-flex align-items-center account-info-item">
                                                        <div class="icon-box me-3" style="width: 40px; height: 40px; background-color: rgba(81, 145, 240, 0.1); color: #5191F0; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                                            <i class="fas fa-envelope"></i>
                                                        </div>
                                                        <div>
                                                            <small class="text-muted d-block">Email Address</small>
                                                            <div class="fw-bold">@Model._user.Email</div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <div class="d-flex align-items-center account-info-item">
                                                        <div class="icon-box me-3" style="width: 40px; height: 40px; background-color: rgba(92, 188, 107, 0.1); color: #5CBC6B; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                                            <i class="fas fa-phone-alt"></i>
                                                        </div>
                                                        <div>
                                                            <small class="text-muted d-block">Phone Number</small>
                                                            <div class="fw-bold">@(string.IsNullOrEmpty(Model._user.PhoneNumber) ? "Not specified" : Model._user.PhoneNumber)</div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <div class="d-flex align-items-center account-info-item">
                                                        <div class="icon-box me-3" style="width: 40px; height: 40px; background-color: rgba(255, 73, 124, 0.1); color: #FF497C; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                                            <i class="fas fa-map-marker-alt"></i>
                                                        </div>
                                                        <div>
                                                            <small class="text-muted d-block">Country</small>
                                                            <div class="fw-bold">@(string.IsNullOrEmpty(Model._user.Country) ? "Not specified" : Model._user.Country)</div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <div class="d-flex align-items-center account-info-item">
                                                        <div class="icon-box me-3" style="width: 40px; height: 40px; background-color: rgba(255, 193, 7, 0.1); color: #FFC107; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                                            <i class="fas fa-calendar-alt"></i>
                                                        </div>
                                                        <div>
                                                            <small class="text-muted d-block">Member Since</small>
                                                            <div class="fw-bold">@Model._user.CreatedAt?.ToString("dd MMM, yyyy")</div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-12 mt-2 text-center">
                                                    <a class="axil-btn" data-bs-toggle="tab" href="#nav-account" role="tab">Edit Account Details</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="nav-orders" role="tabpanel">
                                <div class="axil-dashboard-order">
                                    <h4 class="mb-4">Your Orders History</h4>
                                    
                                    <!-- Orders Filter and Search -->
                                    <div class="mb-4 d-flex justify-content-between align-items-center">
                                        <div class="form-group mb-0">
                                            <select id="orderStatusFilter" class="form-select">
                                                <option value="">All Statuses</option>
                                                <option value="Processing">Processing</option>
                                                <option value="Shipped">Shipped</option>
                                                <option value="Delivered">Delivered</option>
                                                <option value="Completed">Completed</option>
                                                <option value="Cancelled">Cancelled</option>
                                            </select>
                                        </div>
                                        <div class="d-flex">
                                            <input type="text" id="orderSearchInput" class="form-control" placeholder="Search orders...">
                                        </div>
                                    </div>

                                    @if (Model._orders.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-hover orders-table">
                                                <thead class="bg-light">
                                                    <tr>
                                                        <th scope="col">Order ID</th>
                                                        <th scope="col">Date</th>
                                                        <th scope="col">Status</th>
                                                        <th scope="col">Total</th>
                                                        <th scope="col">Items</th>
                                                        <th scope="col">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="ordersTableBody">
                                                    @foreach (var order in Model._orders)
                                                    {
                                                        <tr class="order-row" data-status="@order.Status" data-order-id="@order.Id">
                                                            <td class="fw-bold">
                                                                <span class="order-icon"><i class="fas fa-shopping-basket"></i></span>
                                                                #@order.Id
                                                            </td>
                                                            <td>
                                                                <div>@order.CreatedAt?.ToString("MMM dd, yyyy")</div>
                                                                <small class="text-muted">@order.CreatedAt?.ToString("hh:mm tt")</small>
                                                            </td>
                                                            <td>
                                                                @{
                                                                    var statusClass = order.Status switch
                                                                    {
                                                                        "Processing" => "bg-info",
                                                                        "Shipped" => "bg-primary",
                                                                        "Delivered" => "bg-success",
                                                                        "Completed" => "bg-success",
                                                                        "Cancelled" => "bg-danger",
                                                                        _ => "bg-secondary"
                                                                    };
                                                                }
                                                                <span class="badge @statusClass">@order.Status</span>
                                                            </td>
                                                            <td class="fw-bold">$@order.TotalAmount</td>
                                                            <td>@(order.OrderDetails?.Count() ?? 0) items</td>
                                                            <td>
                                                                <button class="axil-btn btn-sm view-btn showOrderDetails" data-order-id="@order.Id">
                                                                    View Details
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-5">
                                            <div class="empty-orders mb-3">
                                                <i class="fas fa-shopping-cart fa-3x text-muted"></i>
                                            </div>
                                            <h5>No Orders Found</h5>
                                            <p class="text-muted">You haven't placed any orders yet.</p>
                                            <a asp-controller="Products" asp-action="shop" class="axil-btn">Start Shopping</a>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="tab-pane fade" id="nav-downloads" role="tabpanel">
                                <div class="axil-dashboard-order">
                                    <h4 class="mb-4">Your Downloadable Items</h4>
                                    
                                    <div class="row">
                                        @{
                                            // Get all unique cards from orders
                                            var purchasedCards = new List<Card>();
                                            if (Model._orders != null && Model._orders.Any())
                                            {
                                                foreach (var order in Model._orders)
                                                {
                                                    if (order.OrderDetails != null)
                                                    {
                                                        foreach (var item in order.OrderDetails)
                                                        {
                                                            if (item.Card != null && !purchasedCards.Any(c => c.Id == item.Card.Id))
                                                            {
                                                                purchasedCards.Add(item.Card);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        @if (purchasedCards.Any())
                                        {
                                            <div class="downloads-filter mb-4">
                                                <div class="form-group">
                                                    <input type="text" id="downloadSearchInput" class="form-control" placeholder="Search downloads...">
                                                </div>
                                            </div>

                                            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4" id="downloadsGrid">
                                                @foreach (var card in purchasedCards)
                                                {
                                                    <div class="col download-item">
                                                        <div class="card h-100 border-0 shadow-sm">
                                                            <div class="card-img-top position-relative">
                                                                <img src="~/assets/images/product/@card.ImageUrl" alt="@card.CardName" class="img-fluid" style="height: 200px; object-fit: contain; width: 100%;">
                                                                <div class="download-overlay">
                                                                    <button class="btn btn-primary download-btn" data-card-id="@card.Id" data-image-url="/assets/images/product/@card.ImageUrl" data-card-name="@card.CardName">
                                                                        <i class="fas fa-download"></i> Download
                                                                    </button>
                                                                </div>
                                                            </div>
                                                            <div class="card-body">
                                                                <h5 class="card-title">@card.CardName</h5>
                                                                <p class="card-text text-muted">
                                                                    <small>Purchased on: @Model._orders.FirstOrDefault(o => o.OrderDetails.Any(od => od.CardId == card.Id))?.CreatedAt?.ToString("MMM dd, yyyy")</small>
                                                                </p>
                                                            </div>
                                                            <div class="card-footer bg-transparent border-0 text-center">
                                                                <a href="/Products/productDetails/@card.Id" class="btn btn-outline-primary">View Details</a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-center py-5">
                                                <div class="empty-downloads mb-3">
                                                    <i class="fas fa-cloud-download-alt fa-3x text-muted"></i>
                                                </div>
                                                <h5>No Downloads Available</h5>
                                                <p class="text-muted">You haven't purchased any downloadable items yet.</p>
                                                <a asp-controller="Products" asp-action="shop" class="axil-btn">Start Shopping</a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="nav-address" role="tabpanel">
                                <div class="axil-dashboard-address">
                                    <p class="notice-text">The following addresses will be used on the checkout page by default.</p>
                                    <div class="row row--30">
                                        <div class="col-lg-6">
                                            <div class="address-info mb--40">
                                                <div class="addrss-header d-flex align-items-center justify-content-between">
                                                    <h4 class="title mb-0">Shipping Address</h4>
                                                    <a href="#" class="address-edit"><i class="far fa-edit"></i></a>
                                                </div>
                                                <ul class="address-details">
                                                    <li>Name: Annie Mario</li>
                                                    <li>Email: annie@example.com</li>
                                                    <li>Phone: 1234 567890</li>
                                                    <li class="mt--30">
                                                        7398 Smoke Ranch Road <br>
                                                        Las Vegas, Nevada 89128
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                        <div class="col-lg-6">
                                            <div class="address-info">
                                                <div class="addrss-header d-flex align-items-center justify-content-between">
                                                    <h4 class="title mb-0">Billing Address</h4>
                                                    <a href="#" class="address-edit"><i class="far fa-edit"></i></a>
                                                </div>
                                                <ul class="address-details">
                                                    <li>Name: Annie Mario</li>
                                                    <li>Email: annie@example.com</li>
                                                    <li>Phone: 1234 567890</li>
                                                    <li class="mt--30">
                                                        7398 Smoke Ranch Road <br>
                                                        Las Vegas, Nevada 89128
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="nav-account" role="tabpanel">
                                <div class="col-lg-9">
                                    <div class="axil-dashboard-account">
                                        <form class="account-details-form" method="post" asp-action="updateProfile" asp-controller="User">
                                            @Html.AntiForgeryToken()
                                            <div class="row">
                                                <div class="col-lg-6">
                                                    <div class="form-group">
                                                        <label>First Name</label>
                                                        <input asp-for="_update.FirstName" class="form-control" value="@Model._user.FirstName" />
                                                        <span asp-validation-for="_update.FirstName" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-lg-6">
                                                    <div class="form-group">
                                                        <label>Last Name</label>
                                                        <input asp-for="_update.LastName" class="form-control" value="@Model._user.LastName" />
                                                        <span asp-validation-for="_update.LastName" class="text-danger"></span>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <h5 class="title">UserName</h5>
                                                    <div class="form-group">
                                                        <label>UserName</label>
                                                        <input asp-for="_update.Username" class="form-control" value="@Model._user.Username" />
                                                        <span asp-validation-for="_update.Username" class="text-danger"></span>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <h5 class="title">Phone Number</h5>
                                                    <div class="form-group">
                                                        <label>Phone Number</label>
                                                        <input asp-for="_update.PhoneNumber" class="form-control" value="@Model._user.PhoneNumber" />
                                                        <span asp-validation-for="_update.PhoneNumber" class="text-danger"></span>
                                                    </div>

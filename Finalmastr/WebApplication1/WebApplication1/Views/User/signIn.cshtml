@model SemiColon.Models.ViewModel.LoginViewModel

@{
	Layout = "~/Views/Shared/master.cshtml";
    ViewBag.Title = "Sign In";
}

<div class="axil-signin-area">

    <!-- Start Header -->
    <div class="signin-header">
        <div class="row align-items-center">
            <div class="col-sm-4">
                <a href="index.html" class="site-logo"><img src="~/assets/images/logo/image_red_neon.png" alt="logo" style="width:40vh"></a>
            </div>
            <div class="col-sm-8">
                <div class="singin-header-btn">
                    <p>Not a member?</p>
                    <a asp-action="signUp" asp-controller="User" class="axil-btn btn-bg-secondary sign-up-btn">Sign Up Now</a>
                </div>
            </div>
        </div>
    </div>
    <!-- End Header -->

    <div class="row">
        <div class="col-xl-4 col-lg-6">
            <div class="axil-signin-banner bg_image bg_image--9">
                <h3 class="title">We Offer the Best Products</h3>
            </div>
        </div>
        <div class="col-lg-6 offset-xl-2">
            <div class="axil-signin-form-wrap">
                <div class="axil-signin-form">
                    <h3 class="title">Sign in to eTrade.</h3>
                    <p class="b2 mb--55">Enter your detail below</p>
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mt-3 mb-4">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        </div>
                    }
                    
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-3 mb-4" role="alert">
                            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                        </div>
                    }
                    
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mt-3 mb-4" role="alert">
                            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                        </div>
                    }
                    
                    @using (Html.BeginForm("checkSignIn", "User", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label asp-for="Email"></label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "annie@example.com" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="Password"></label>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter your password" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        </div>
                        
                        @* <div class="form-group d-flex align-items-center"> *@
                        @*     <div class="form-check"> *@
                        @*         @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" }) *@
                        @*         <label asp-for="RememberMe" class="form-check-label"></label> *@
                        @*     </div> *@
                        @* </div> *@
                        
                        <div class="form-group d-flex align-items-center justify-content-between">
                            <button type="submit" class="axil-btn btn-bg-primary submit-btn">Sign In</button>
                            <a asp-action="forgotPassword" asp-controller="User" class="forgot-btn">Forgot password?</a>
                        </div>
                        
                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div class="alert alert-danger mt-3" role="alert">
                                <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).ready(function () {
            // Add custom validation styling
            $.validator.setDefaults({
                highlight: function (element) {
                    $(element).addClass('is-invalid').removeClass('is-valid');
                },
                unhighlight: function (element) {
                    $(element).addClass('is-valid').removeClass('is-invalid');
                }
            });
        });
    </script>
}

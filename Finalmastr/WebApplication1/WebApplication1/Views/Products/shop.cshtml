@section Scripts {
    <script>
        // Create Toast notification style
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 1500,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        $(document).ready(function () {
            // Prevent multiple clicks processing
            let isProcessing = false;
            
            // Load user's favorites
            loadUserFavorites();
            
            // إعادة ربط أحداث المفضلة لعلاج مشكلة عدم القدرة على إزالة المنتج بعد إضافته
            function attachFavoritesHandlers() {
                // إزالة معالجات الأحداث السابقة ثم ربط معالج جديد
                $('.addToFavoritesBtn').off('click').on('click', function (e) {
                e.preventDefault();
                
                if (isProcessing) return;
                isProcessing = true;
                
                var $button = $(this);
                var $heartIcon = $button.find('i');
                var productId = $button.data('product-id');
                
                // Show loading state
                $heartIcon.removeClass('far fas').addClass('fa-spinner fa-spin');
                
                $.ajax({
                    url: '/Products/addToFavorites',
                    type: 'POST',
                    data: { id: productId },
                    success: function(response) {
                        if (response.success) {
                            // Update favorites count in header
                            $.ajax({
                                url: '/Products/GetFavoritesCount',
                                type: 'GET',
                                success: function(countResponse) {
                                    if (countResponse.success) {
                                        const favCount = parseInt(countResponse.favoritesCount);
                                        $('.favorites-count').text(favCount);
                                        if (favCount === 0) {
                                            $('.favorites-count').addClass('hidden');
                                        } else {
                                            $('.favorites-count').removeClass('hidden');
                                        }
                                    }
                                }
                            });
                            
                            // Toggle heart icon
                            $heartIcon.removeClass('fa-spinner fa-spin');
                            if (response.added) {
                                $heartIcon.removeClass('far').addClass('fas'); // Solid heart - مفضل
                                // تحديث جميع الأيقونات لنفس المنتج
                                $('.addToFavoritesBtn[data-product-id="' + productId + '"] i').removeClass('far').addClass('fas');
                                
                                // Direct toast notification
                                Toast.fire({
                                    icon: 'success',
                                    title: 'Added to Wishlist'
                                });
                            } else {
                                $heartIcon.removeClass('fas').addClass('far'); // Outline heart - غير مفضل
                                // تحديث جميع الأيقونات لنفس المنتج
                                $('.addToFavoritesBtn[data-product-id="' + productId + '"] i').removeClass('fas').addClass('far');
                                
                                // Direct toast notification
                                Toast.fire({
                                    icon: 'info',
                                    title: 'Removed from Wishlist'
                                });
                            }
                        } else {
                            // Reset icon
                            $heartIcon.removeClass('fa-spinner fa-spin').addClass('far');
                            
                            Toast.fire({
                                icon: 'error',
                                title: 'Failed to update wishlist'
                            });
                        }
                    },
                    error: function() {
                        // Reset icon
                        $heartIcon.removeClass('fa-spinner fa-spin').addClass('far');
                        
                        Toast.fire({
                            icon: 'error',
                            title: 'Error occurred'
                        });
                    },
                    complete: function() {
                        isProcessing = false;
                        // إعادة ربط معالجات الأحداث بعد الانتهاء
                        attachFavoritesHandlers();
                    }
                });
            }
            
            // تفعيل معالج الأحداث الأول
            attachFavoritesHandlers();
            
            // Add to cart with preventing double submissions
            $('.addToCartBtn').click(function (e) {
                e.preventDefault();
                
                if (isProcessing) return;
                isProcessing = true;
                
                var $button = $(this);
                var productId = $button.data('product-id');
                
                // Show loading state
                var originalText = $button.text();
                $button.text('Adding...').addClass('disabled');
                
                $.ajax({
                    url: '/Products/addToCart',
                    type: 'POST',
                    data: { id: productId },
                    success: function (response) {
                        if (response.success) {
                            // Update cart count
                            $('.cart-count').text(response.cartCount);
                            if (response.cartCount > 0) {
                                $('.cart-count').removeClass('hidden');
                            }
                            
                            // Direct toast notification
                            Toast.fire({
                                icon: 'success',
                                title: 'Added to Cart'
                            });
                        } else {
                            Toast.fire({
                                icon: 'error',
                                title: 'Failed to add to cart'
                            });
                        }
                    },
                    error: function () {
                        Toast.fire({
                            icon: 'error',
                            title: 'Error occurred'
                        });
                    },
                    complete: function () {
                        // Reset button state
                        $button.text(originalText).removeClass('disabled');
                        isProcessing = false;
                    }
                });
            });
        });
        
        // Function to load and display user's favorites
        function loadUserFavorites() {
            console.log("Shop: Loading user favorites...");
            $.ajax({
                url: '/Products/GetUserFavorites',
                type: 'GET',
                success: function(response) {
                    console.log("Shop: Favorites response received", response);
                    if (response.success && response.favorites) {
                        // Update heart icons for user's favorite items
                        $('.addToFavoritesBtn').each(function() {
                            const $btn = $(this);
                            const productId = $btn.data('product-id');
                            if (response.favorites.includes(productId)) {
                                console.log("Product " + productId + " is in favorites");
                                $btn.find('i').removeClass('far').addClass('fas');
                            } else {
                                $btn.find('i').removeClass('fas').addClass('far');
                            }
                        });
                    }
                    else {
                        console.log("No favorites found or error in response");
                    }
                },
                error: function() {
                    console.log('Error loading user favorites');
                }
            });
        }
    </script>
}
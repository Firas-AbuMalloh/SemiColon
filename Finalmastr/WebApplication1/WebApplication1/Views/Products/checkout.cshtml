<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form[action*="checkoutBtn"]');
        const phoneInput = document.getElementById('phone');
        const emailInput = document.getElementById('email');
        const paymentInputs = document.querySelectorAll('input[name="payment"]');
        const giftCheckbox = document.getElementById('sendAsGiftCheckbox');
        const giftFields = document.querySelectorAll('#firstNameGift, #lastNameGift, #phoneGift, #emailGift');

        // Toggle gift fields based on checkbox
        giftCheckbox.addEventListener('change', function() {
            const isGift = this.checked;
            giftFields.forEach(field => {
                field.required = isGift;
            });
        });

        form.addEventListener('submit', function(event) {
            let isValid = true;

            // Check phone
            if (!phoneInput.value) {
                phoneInput.classList.add('is-invalid');
                isValid = false;
            } else {
                phoneInput.classList.remove('is-invalid');
            }

            // Check email
            if (!emailInput.value) {
                emailInput.classList.add('is-invalid');
                isValid = false;
            } else {
                emailInput.classList.remove('is-invalid');
            }

            // Check payment method
            let paymentSelected = false;
            paymentInputs.forEach(input => {
                if (input.checked) {
                    paymentSelected = true;
                }
            });

            if (!paymentSelected) {
                isValid = false;
                document.querySelector('.order-payment-method').classList.add('has-error');
            } else {
                document.querySelector('.order-payment-method').classList.remove('has-error');
            }

            // Check gift fields if gift option is selected
            if (giftCheckbox.checked) {
                giftFields.forEach(field => {
                    if (!field.value && field.id !== 'massegeGift') {
                        field.classList.add('is-invalid');
                        isValid = false;
                    } else {
                        field.classList.remove('is-invalid');
                    }
                });
            }

            if (!isValid) {
                event.preventDefault();
            }
        });
    });
</script>

<style>
    .is-invalid {
        border-color: #dc3545 !important;
    }
    .has-error {
        border: 1px solid #dc3545;
        padding: 10px;
        border-radius: 5px;
    }
    .text-danger {
        color: #dc3545;
        font-size: 14px;
        margin-top: 5px;
        display: block;
    }
</style>

    <div class="axil-product-area bg-color-white axil-section-gap" id="ourProducts">
        <div class="container">
            <div class="section-title-wrapper">
                <span class="title-highlighter highlighter-primary"> <i class="far fa-shopping-basket"></i> Our Products</span>
                <h2 class="title">Explore our Products</h2>
                <h6 class="">main category</h6>
                <div class="isotope-button">
                    <button data-filter="*" class="is-checked"><span class="filter-text">All</span></button>
                    <button data-filter=".1" class=""><span class="filter-text">App Store</span></button>
                    <button data-filter=".2"><span class="filter-text">Gaming</span></button>
                    <button data-filter=".3"><span class="filter-text">Cash Card</span></button>
                    <button data-filter=".4"><span class="filter-text">Telecom Recharge</span></button>
                    <button data-filter=".5"><span class="filter-text">Shopping</span></button>
                    <button data-filter=".6"><span class="filter-text">Video & Entertainment</span></button>
                    <button data-filter=".7"><span class="filter-text">Music Subscriptions</span></button>
                    <button data-filter=".8"><span class="filter-text">Delivery</span></button>
                    <button data-filter=".9"><span class="filter-text">Travel & Experiences</span></button>
                </div>
               
            </div>
            <div class="explore-product-activation slick-layout-wrapper slick-layout-wrapper--15 axil-slick-arrow arrow-top-slide">
                <div class="slick-single-layout">
                    <div class="row row--15 grid row productss">
                        @* @foreach (var product in Model.Products) *@
                        @* @for (int i = 0; i < 12 && i < productList.Count; i++) *@
                        @foreach(var product in Model.Products)
                        {
                            @* var product = productList[i]; *@

                            <input type="number" name="Id" hidden />
                            <div class="col-xl-3 col-lg-4 col-sm-6 col-12 mb--30 grid-item @product.Category.MainCategory.Id">
                                <div class="axil-product product-style-one">
                                    <div class="thumbnail">
                                        <a asp-action="productDetails" asp-controller="Products" asp-route-id="@product.Id">
                                            <img data-sal="zoom-out" data-sal-delay="200" data-sal-duration="800" loading="lazy" class="main-img" src="~/assets/images/product/@product.ImageUrl" alt="Product Images" />
                                            <img class="hover-img" src="~/assets/images/product/@product.ImageUrl" alt="Product Images" />
                                        </a>

                                        @* <div class="label-block label-right"> *@
                                        @*     <div class="product-badget">20% Off</div> *@
                                        @* </div> *@

                                        <div class="product-hover-action">
                                            <ul class="cart-action">
                                                <li class="quickview">
                                                    <a asp-action="productDetails" asp-controller="Products" asp-route-id="@product.Id">
                                                        <i class="far fa-eye"></i>
                                                    </a>
                                                </li>
                                                <li class="select-option">
                                                    <a href="#" class="addToCartBtn" data-product-id="@product.Id">
                                                        Add to Cart
                                                    </a>
                                                </li>
                                                <li class="wishlist">
                                                    <a href="#" class="addToFavoritesBtn" data-product-id="@product.Id">
                                                        <i class="far fa-heart"></i>
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div class="product-content">
                                        <div class="inner">
                                            @* <div class="product-rating"> *@
                                            @*     <span class="icon"> *@
                                            @*         <i class="fas fa-star"></i> *@
                                            @*         <i class="fas fa-star"></i> *@
                                            @*         <i class="fas fa-star"></i> *@
                                            @*         <i class="fas fa-star"></i> *@
                                            @*         <i class="fas fa-star"></i> *@
                                            @*     </span> *@
                                            @*     <span class="rating-number">(64)</span> *@
                                            @* </div> *@
                                            <h5 class="title"><a asp-action="productDetails" asp-controller="Products" asp-route-id="@product.Id">@product.CardName</a></h5>
                                            <div class="product-price-variant">
                                                <span class="price current-price">$@product.Price</span>
                                                @* <span class="price old-price">$49.99</span> *@
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <!-- End .slick-single-layout -->
            </div>
            <div class="row">
                <div class="col-lg-12 text-center mt--20 mt_sm--0">
                    <a asp-action="shop" asp-controller="Products" class="axil-btn btn-bg-lighter btn-load-more">View All Products</a>
                </div>
            </div>
        </div>
    </div>

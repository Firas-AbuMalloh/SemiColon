<script>
    // تأكد من أن الصفحة حملت بالكامل
    document.addEventListener('DOMContentLoaded', function () {
      var iso = new Isotope('.grid', {
        itemSelector: '.grid-item',
        layoutMode: 'fitRows'
      });

      // أزرار الفلترة
      var filtersElem = document.querySelector('.isotope-button');
      filtersElem.addEventListener('click', function (event) {
        if (!event.target.closest('button')) return;
        var filterValue = event.target.closest('button').getAttribute('data-filter');
        iso.arrange({ filter: filterValue });

        // تبديل الكلاسات لتحديد الزر المفعّل
        filtersElem.querySelectorAll('button').forEach(btn => btn.classList.remove('is-checked'));
        event.target.closest('button').classList.add('is-checked');
      });
    });
</script>
<script>
    $(document).ready(function () {
        let isCartProcessing = false;
        // استخدم Set لتتبع المنتجات قيد المعالجة في المفضلة
        const favProcessingSet = new Set();
        
        // Initialize once on page load
        loadUserFavorites();
        
        // Unbind any existing handlers first to prevent duplicates
        $(document).off('click', '.addToCartBtn').on('click', '.addToCartBtn', function (e) {
            e.preventDefault();
            e.stopPropagation();
            
            if (isCartProcessing) return;
            isCartProcessing = true;
            
            var $button = $(this);
            var productId = $button.data('product-id');
            
            // Show loading state
            var originalText = $button.text();
            $button.text('Adding...').addClass('disabled');
            
            $.ajax({
                url: '/Products/addToCart',
                type: 'POST',
                data: { id: productId },
                success: function (response) {
                    if (response.success) {
                        // Update cart count
                        $('.cart-count').text(response.cartCount);
                        if (response.cartCount > 0) {
                            $('.cart-count').removeClass('hidden');
                        }
                        
                        Swal.fire({
                            icon: 'success',
                            title: 'Added To Cart',
                            text: response.message || 'Product added to cart successfully.',
                            timer: 1500,
                            showConfirmButton: false
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message || 'Failed to add product to cart.'
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An error occurred while processing your request.'
                    });
                },
                complete: function () {
                    // Reset button state
                    $button.text(originalText).removeClass('disabled');
                    
                    // Delay re-enabling the button to prevent accidental double-clicks
                    setTimeout(function() {
                        isCartProcessing = false;
                    }, 500);
                }
            });
        });
        
        // إعادة تعريف معالج أحداث المفضلة لضمان عمله بعد كل عملية
        function attachFavoritesHandlers() {
            // إلغاء أي معالج سابق ثم ربط معالج جديد
            $(document).off('click', '.addToFavoritesBtn');
            $('.addToFavoritesBtn').off('click').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var $button = $(this);
                var $heartIcon = $button.find('i');
                var productId = $button.data('product-id');
                if (favProcessingSet.has(productId)) return; // منع التكرار لنفس المنتج
                favProcessingSet.add(productId);
                $button.addClass('disabled');
                // Show loading state
                $heartIcon.removeClass('far fas').addClass('fa-spinner fa-spin');
                $.ajax({
                    url: '/Products/addToFavorites',
                    type: 'POST',
                    data: { id: productId },
                    success: function(response) {
                        if (response.success) {
                            // Update favorites count in header
                            $.ajax({
                                url: '/Products/GetFavoritesCount',
                                type: 'GET',
                                success: function(countResponse) {
                                    if (countResponse.success) {
                                        const favCount = parseInt(countResponse.favoritesCount);
                                        $('.favorites-count').text(favCount);
                                        if (favCount === 0) {
                                            $('.favorites-count').addClass('hidden');
                                        } else {
                                            $('.favorites-count').removeClass('hidden');
                                        }
                                    }
                                }
                            });
                            
                            // Reset icon and apply appropriate class based on response
                            $heartIcon.removeClass('fa-spinner fa-spin');
                            if (response.added) {
                                $heartIcon.removeClass('far').addClass('fas');
                                
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Added to Wishlist',
                                    text: response.message || 'Product added to your wishlist.',
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                            } else {
                                $heartIcon.removeClass('fas').addClass('far');
                                
                                Swal.fire({
                                    icon: 'info',
                                    title: 'Removed from Wishlist',
                                    text: response.message || 'Product removed from your wishlist.',
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                            }
                        } else {
                            // Reset icon on error
                            $heartIcon.removeClass('fa-spinner fa-spin').addClass('far');
                            
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message
                            });
                        }
                    },
                    error: function() {
                        // Reset icon on error
                        $heartIcon.removeClass('fa-spinner fa-spin').addClass('far');
                        
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An error occurred while updating your wishlist.'
                        });
                    },
                    complete: function() {
                        $button.removeClass('disabled');
                        favProcessingSet.delete(productId);
                        // إعادة تعريف معالج الأحداث بعد الانتهاء من الطلب
                        attachFavoritesHandlers();
                    }
                });
            });
        }
        
        // تفعيل معالج الأحداث الأول
        attachFavoritesHandlers();
    });
    
    function loadUserFavorites() {
        console.log("Index: Loading user favorites...");
        $.ajax({
            url: '/Products/GetUserFavorites',
            type: 'GET',
            success: function(response) {
                console.log("Index: Favorites data:", response);
                if (response.success && response.favorites) {
                    // Update heart icons for user's favorite items
                    $('.addToFavoritesBtn').each(function() {
                        const $btn = $(this);
                        const productId = $btn.data('product-id');
                        if (response.favorites.includes(productId)) {
                            console.log("Product " + productId + " is in favorites");
                            $btn.find('i').removeClass('far').addClass('fas');
                        } else {
                            $btn.find('i').removeClass('fas').addClass('far');
                        }
                    });
                }
                else {
                    console.log("No favorites found or error in response");
                }
            },
            error: function() {
                console.log('Error loading user favorites');
            }
        });
    }
</script>



@using SemiColon.Models.ViewModel

@model indexViewModel

@{
    Layout = "~/Views/Shared/mainLayoutHeaderFooter.cshtml";
    ViewBag.Title = "Home";
    var productList = Model.Products.ToList();

}
<style>
    .productss {
        height: 800px !important;
        padding-bottom: 40rem !important;
        overflow-y: scroll !important;
        scrollbar-width: auto; /* يظهر شريط التمرير بشكل واضح في Firefox */
        scrollbar-color: #3A3A3A #F5F5F5; /* لون الشريط + الخلفية */
    }

        /* تنسيق شريط التمرير لمتصفحات Chrome/Edge/Safari */
        .productss::-webkit-scrollbar {
            width: 12px; /* عرض أكبر للوضوح */
        }

        .productss::-webkit-scrollbar-track {
            background: #F5F5F5;
            border-radius: 10px;
            box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.1); /* تأثير عمق */
            border: 1px solid #E0E0E0; /* حدود لتوضيح المسار */
        }

        .productss::-webkit-scrollbar-thumb {
            background: linear-gradient(45deg, #3A3A3A, #6D6D6D); /* تدرج لوني */
            border-radius: 10px;
            border: 2px solid #F5F5F5; /* حدود بيضاء لفصل الشريط عن المسار */
            transition: all 0.3s ease; /* حركة سلسة */
        }

            .productss::-webkit-scrollbar-thumb:hover {
                background: linear-gradient(45deg, #2C2C2C, #5A5A5A); /* تدرج داكن عند التحويم */
                transform: scale(1.05); /* تكبير بسيط للإشارة إلى التفاعل */
                cursor: grab; /* أيقونة اليد للإمساك */
            }

            .productss::-webkit-scrollbar-thumb:active {
                cursor: grabbing; /* أيقونة اليد أثناء السحب */
                background: linear-gradient(45deg, #1E1E1E, #4A4A4A);
            }

    /* رسوم متحركة لفتح الانتباه */
    @@keyframes pulse-scrollbar {
        0%

    {
        opacity: 0.7;
    }

    50% {
        opacity: 1;
    }

    100% {
        opacity: 0.7;
    }

    }

    /* تطبيق الرسوم المتحركة عند التحميل */
    .productss::-webkit-scrollbar-thumb {
        animation: pulse-scrollbar 2s infinite;
    }
</style>
<main class="main-wrapper">
    <!-- Start Slider Area -->
    <div class="axil-main-slider-area main-slider-style-3">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-xl-6 col-lg-6">
                    <div class="main-slider-content">
                        <span class="subtitle"><i class="fas fa-fire"></i>Largest Cards marketplace</span>
                        <h1 class="title">Discover, collect, and sell extraordinary cards</h1>
                        <h1 class="title"> @Context.Session.GetInt32("CartIDDDDD")</h1>
                        <div class="shop-btn">
                            <a asp-action="categoryShop" asp-controller="Products" class="axil-btn btn-bg-white right-icon">Explore <i class="fal fa-long-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col-xl-6 col-lg-6">
                    <div class="main-slider-large-thumb">
                        <div class="slider-thumb-activation-two axil-slick-dots">
                            @foreach (var categoryItem in Model.Categories)
                            {
                                <div class="single-slide slick-slide">
                                    <div class="axil-product product-style-five">
                                        <div class="thumbnail">
                                            <a asp-action="shop" asp-controller="Products" asp-route-id="@categoryItem.Id" >
                                                <img src="~/assets/images/product/categories/categories/@categoryItem.ImageUrl" alt="Category Image">
                                            </a>
                                        </div>
                                        <div class="product-content">
                                            <div class="inner">
                                                <h5 class="title fw-bold text-dark fs-3"><a asp-action="shop" asp-controller="Products" asp-route-id="@categoryItem.Id">@categoryItem.CategoryName</a></h5>
                                                <div class="product-price-variant">
                                                    @* <span class="fs-4">@categoryItem.Description</span> *@
                                                </div>
                                                <ul class="cart-action">
                                                    <li class="select-option"><a asp-action="shop" asp-controller="Products" asp-route-id="@categoryItem.Id">Buy Products</a></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Slider Area -->
    
    <!-- Start Categorie Area  -->
    <div class="axil-categorie-area bg-color-white axil-section-gap pb--0" id="mainCategory">
        <div class="container">
            <div class="product-area pb--50">
                <div class="section-title-wrapper">
                    <span class="title-highlighter highlighter-secondary"><i class="far fa-shopping-basket"></i>The Categories</span>
                    <h2 class="title">Browse by Category</h2>
                </div>
                <div class="categrie-product-activation-3 slick-layout-wrapper--15 axil-slick-arrow arrow-top-slide">
                    @foreach (var categotyItem in Model.MainCategories)
                    {
                        <div class="slick-single-layout">
                            <div class="categrie-product categrie-product-3" data-sal="zoom-out" data-sal-delay="100" data-sal-duration="500">
                                <a asp-action="categoryShop" asp-controller="Products" asp-route-id="@categotyItem.Id">
                                    <img class="img-fluid" src="~/assets/images/product/categories/MainCategories/@categotyItem.ImageUrl" alt="product categorie">
                                    <h6 class="cat-title">@categotyItem?.MainCategoryName</h6>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <!-- End Categorie Area  -->
    

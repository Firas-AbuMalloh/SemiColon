@section Scripts {
    <script>
        // Create Toast notification style
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 1500,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        // تتبع الطلبات المرسلة لمنع التكرار
        const sentRequests = new Set();

        $(document).ready(function () {
            // تنظيف أي event handlers قديمة
            $('.addToCartBtn').off('click');
            $('.addToFavoritesBtn').off('click');
            
            // إيقاف أي معالجات أحداث مرتبطة بالوثيقة
            $(document).off('click', '.addToCartBtn');
            $(document).off('click', '.addToFavoritesBtn');
            
            let isCartProcessing = false;
            let isFavProcessing = false;
            
            // Initialize once on page load
            loadUserFavorites();
            
            // Scroll animation
            document.querySelector('.productss')?.addEventListener('scroll', function() {
                this.style.setProperty('--scrollbar-animation', 'none');
            }, { once: true });
            
            // استخدام حدث نقر مباشر بدلاً من تفويض الحدث
            $('.addToCartBtn').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                
                if (isCartProcessing) return;
                isCartProcessing = true;
                
                var $button = $(this);
                var productId = $button.data('product-id');
                
                // إنشاء معرف فريد للطلب
                const requestId = `cart_${productId}_${Date.now()}`;
                
                // التحقق مما إذا كان الطلب مرسل بالفعل
                if (sentRequests.has(productId)) {
                    console.log('Request already sent for product:', productId);
                    $button.text('Already added').addClass('disabled');
                    
                    setTimeout(function() {
                        $button.text('Add to Cart').removeClass('disabled');
                        isCartProcessing = false;
                    }, 1500);
                    
                    return;
                }
                
                // تعليم المنتج كمرسل
                sentRequests.add(productId);
                
                // Show loading state
                var originalText = $button.text();
                $button.text('Adding...').addClass('disabled');
                
                $.ajax({
                    url: '/Products/addToCart',
                    type: 'POST',
                    data: { 
                        id: productId,
                        _requestId: requestId // إضافة معرف الطلب
                    },
                    success: function (response) {
                        if (response.success) {
                            // Update cart count
                            $('.cart-count').text(response.cartCount);
                            if (response.cartCount > 0) {
                                $('.cart-count').removeClass('hidden');
                            }
                            
                            Toast.fire({
                                icon: 'success',
                                title: 'Added To Cart'
                            });
                        } else {
                            Toast.fire({
                                icon: 'error',
                                title: 'Error adding to cart'
                            });
                        }
                    },
                    error: function () {
                        Toast.fire({
                            icon: 'error',
                            title: 'Error occurred'
                        });
                    },
                    complete: function () {
                        // Reset button state
                        $button.text(originalText).removeClass('disabled');
                        
                        // إزالة المنتج من قائمة الطلبات المرسلة بعد فترة
                        setTimeout(function() {
                            sentRequests.delete(productId);
                            isCartProcessing = false;
                        }, 2000);
                    }
                });
            });
            
            // Wishlist functionality
            $('.addToFavoritesBtn').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                
                if (isFavProcessing) return;
                isFavProcessing = true;
                
                var $button = $(this);
                var $heartIcon = $button.find('i');
                var productId = $button.data('product-id');
                
                // Show loading state
                $heartIcon.removeClass('far fas').addClass('fa-spinner fa-spin');
                
                $.ajax({
                    url: '/Products/addToFavorites',
                    type: 'POST',
                    data: { id: productId },
                    success: function(response) {
                        if (response.success) {
                            // Update favorites count in header
                            $.ajax({
                                url: '/Products/GetFavoritesCount',
                                type: 'GET',
                                success: function(countResponse) {
                                    if (countResponse.success) {
                                        const favCount = parseInt(countResponse.favoritesCount);
                                        $('.favorites-count').text(favCount);
                                        if (favCount === 0) {
                                            $('.favorites-count').addClass('hidden');
                                        } else {
                                            $('.favorites-count').removeClass('hidden');
                                        }
                                    }
                                }
                            });
                            
                            // Reset icon and apply appropriate class based on response
                            $heartIcon.removeClass('fa-spinner fa-spin');
                            if (response.added) {
                                $heartIcon.removeClass('far').addClass('fas');
                                
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Added to Wishlist',
                                    text: response.message || 'Product added to your wishlist.',
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                            } else {
                                $heartIcon.removeClass('fas').addClass('far');
                                
                                Swal.fire({
                                    icon: 'info',
                                    title: 'Removed from Wishlist',
                                    text: response.message || 'Product removed from your wishlist.',
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                            }
                        } else {
                            // Reset icon on error
                            $heartIcon.removeClass('fa-spinner fa-spin').addClass('far');
                            
                            Toast.fire({
                                icon: 'error',
                                title: 'Failed to update wishlist'
                            });
                        }
                    },
                    error: function() {
                        // Reset icon on error
                        $heartIcon.removeClass('fa-spinner fa-spin').addClass('far');
                        
                        Toast.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An error occurred while updating your wishlist.'
                        });
                    },
                    complete: function() {
                        // Delay re-enabling the button to prevent accidental double-clicks
                        setTimeout(function() {
                            isFavProcessing = false;
                        }, 2000);
                    }
                });
            });
        });
        
        // Function to load and display user's favorites
        function loadUserFavorites() {
            console.log("Index: Loading user favorites...");
            $.ajax({
                url: '/Products/GetUserFavorites',
                type: 'GET',
                success: function(response) {
                    console.log("Index: Favorites data:", response);
                    if (response.success && response.favorites) {
                        // Update heart icons for user's favorite items
                        $('.addToFavoritesBtn').each(function() {
                            const $btn = $(this);
                            const productId = $btn.data('product-id');
                            if (response.favorites.includes(productId)) {
                                console.log("Product " + productId + " is in favorites");
                                $btn.find('i').removeClass('far').addClass('fas');
                            } else {
                                $btn.find('i').removeClass('fas').addClass('far');
                            }
                        });
                    }
                    else {
                        console.log("No favorites found or error in response");
                    }
                },
                error: function() {
                    console.log('Error loading user favorites');
                }
            });
        }
    </script>
}